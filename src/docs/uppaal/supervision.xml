<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd'>
<nta>
<declaration>// seconds; estimated where the plant value is unknown
const int HB = 5;          // heartbeat T_hb
const int DEADAFTER = 8;   // broker: 1.5 x keep-alive 5 s = 7.5 s, rounded up
const int DETECT = 15;     // THM-REQ-72
const int RESTORE = 60;    // THM-REQ-73
const int ESCALATE = 45;   // MON escalates after this
const int RDMIN = 1;       // Docker restart takes at least this
const int RDMAX = 30;      // estimated upper bound of a restart
clock t;                   // observer: time since the fault
chan hb, restart, freeze;
broadcast chan crash, birth, ndeath, escalate;
</declaration>
<template>
<name>Node</name>
<declaration>clock x;</declaration>
<location id="Node_Starting" x="300" y="0"><name x="280" y="-30">Starting</name><label kind="invariant" x="280" y="15">x &lt;= 1</label></location>
<location id="Node_Online" x="-150" y="173"><name x="-170" y="143">Online</name><label kind="invariant" x="-170" y="188">x &lt;= HB</label></location>
<location id="Node_Down" x="-150" y="-173"><name x="-170" y="-203">Down</name></location>
<init ref="Node_Online"/>
<transition><source ref="Node_Starting"/><target ref="Node_Online"/><label kind="synchronisation" x="83" y="72">birth!</label></transition>
<transition><source ref="Node_Online"/><target ref="Node_Online"/><label kind="guard" x="-95" y="98">x &gt;= HB</label><label kind="synchronisation" x="-95" y="113">hb!</label><label kind="assignment" x="-95" y="128">x = 0</label><nail x="-105" y="118"/><nail x="-195" y="118"/></transition>
<transition><source ref="Node_Online"/><target ref="Node_Down"/><label kind="synchronisation" x="-197" y="-15">crash?</label><nail x="-205" y="0"/></transition>
<transition><source ref="Node_Online"/><target ref="Node_Down"/><label kind="synchronisation" x="-87" y="-15">freeze?</label><nail x="-95" y="0"/></transition>
<transition><source ref="Node_Down"/><target ref="Node_Starting"/><label kind="synchronisation" x="83" y="-101">restart?</label><label kind="assignment" x="83" y="-86">x = 0</label></transition>
</template>
<template>
<name>Broker</name>
<declaration>clock y;</declaration>
<location id="Broker_Alive" x="300" y="0"><name x="280" y="-30">Alive</name><label kind="invariant" x="280" y="15">y &lt;= DEADAFTER</label></location>
<location id="Broker_Notify" x="-150" y="173"><name x="-170" y="143">Notify</name><committed/></location>
<location id="Broker_Dead" x="-150" y="-173"><name x="-170" y="-203">Dead</name></location>
<init ref="Broker_Alive"/>
<transition><source ref="Broker_Alive"/><target ref="Broker_Alive"/><label kind="synchronisation" x="355" y="-60">hb?</label><label kind="assignment" x="355" y="-45">y = 0</label><nail x="345" y="-55"/><nail x="255" y="-55"/></transition>
<transition><source ref="Broker_Alive"/><target ref="Broker_Notify"/><label kind="synchronisation" x="83" y="72">crash?</label></transition>
<transition><source ref="Broker_Notify"/><target ref="Broker_Dead"/><label kind="synchronisation" x="-142" y="-15">ndeath!</label></transition>
<transition><source ref="Broker_Alive"/><target ref="Broker_Dead"/><label kind="guard" x="63" y="-65">y &gt;= DEADAFTER</label><label kind="synchronisation" x="63" y="-50">ndeath!</label><nail x="55" y="-35"/></transition>
<transition><source ref="Broker_Dead"/><target ref="Broker_Alive"/><label kind="synchronisation" x="63" y="-50">birth?</label><label kind="assignment" x="63" y="-35">y = 0</label><nail x="55" y="-35"/></transition>
</template>
<template>
<name>MON</name>
<declaration>clock z;</declaration>
<location id="MON_Watching" x="300" y="0"><name x="280" y="-30">Watching</name></location>
<location id="MON_Failed" x="-150" y="173"><name x="-170" y="143">Failed</name><label kind="invariant" x="-170" y="188">z &lt;= ESCALATE</label></location>
<location id="MON_Escalated" x="-150" y="-173"><name x="-170" y="-203">Escalated</name></location>
<init ref="MON_Watching"/>
<transition><source ref="MON_Watching"/><target ref="MON_Failed"/><label kind="synchronisation" x="103" y="123">ndeath?</label><label kind="assignment" x="103" y="138">z = 0</label><nail x="95" y="138"/></transition>
<transition><source ref="MON_Failed"/><target ref="MON_Watching"/><label kind="synchronisation" x="103" y="123">birth?</label><nail x="95" y="138"/></transition>
<transition><source ref="MON_Failed"/><target ref="MON_Escalated"/><label kind="guard" x="-142" y="-30">z &gt;= ESCALATE</label><label kind="synchronisation" x="-142" y="-15">escalate!</label></transition>
</template>
<template>
<name>Docker</name>
<declaration>clock d;</declaration>
<location id="Docker_Idle" x="300" y="0"><name x="280" y="-30">Idle</name></location>
<location id="Docker_Restarting" x="-300" y="0"><name x="-320" y="-30">Restarting</name><label kind="invariant" x="-320" y="15">d &lt;= RDMAX</label></location>
<init ref="Docker_Idle"/>
<transition><source ref="Docker_Idle"/><target ref="Docker_Restarting"/><label kind="synchronisation" x="8" y="40">ndeath?</label><label kind="assignment" x="8" y="55">d = 0</label><nail x="0" y="55"/></transition>
<transition><source ref="Docker_Restarting"/><target ref="Docker_Idle"/><label kind="guard" x="8" y="25">d &gt;= RDMIN</label><label kind="synchronisation" x="8" y="40">restart!</label><nail x="0" y="55"/></transition>
</template>
<template>
<name>Env</name>
<declaration></declaration>
<location id="Env_Idle" x="300" y="0"><name x="280" y="-30">Idle</name></location>
<location id="Env_Faulted" x="-300" y="0"><name x="-320" y="-30">Faulted</name></location>
<init ref="Env_Idle"/>
<transition><source ref="Env_Idle"/><target ref="Env_Faulted"/><label kind="synchronisation" x="8" y="40">crash!</label><label kind="assignment" x="8" y="55">t = 0</label><nail x="0" y="55"/></transition>
<transition><source ref="Env_Idle"/><target ref="Env_Faulted"/><label kind="synchronisation" x="8" y="-70">freeze!</label><label kind="assignment" x="8" y="-55">t = 0</label><nail x="0" y="-55"/></transition>
</template>
<system>system Node, Broker, MON, Docker, Env;</system>
</nta>
