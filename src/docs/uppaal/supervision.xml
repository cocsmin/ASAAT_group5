<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd'>
<nta>
<declaration>// seconds; estimated where the plant value is unknown
const int HB = 5;          // heartbeat T_hb
const int DEADAFTER = 8;   // broker: 1.5 x keep-alive 5 s = 7.5 s, rounded up
const int DETECT = 15;     // THM-REQ-72
const int RESTORE = 60;    // THM-REQ-73
const int ESCALATE = 45;   // MON escalates after this
const int RDMIN = 1;       // Docker restart takes at least this
const int RDMAX = 30;      // estimated upper bound of a restart
clock t;                   // observer: time since the fault
chan hb, restart, freeze;
broadcast chan crash, birth, ndeath, escalate;
</declaration>
<template>
<name>Node</name>
<declaration>clock x;</declaration>
<location id="Node_Starting" x="220" y="0"><name x="200" y="-30">Starting</name><label kind="invariant" x="200" y="15">x &lt;= 1</label></location>
<location id="Node_Online" x="-110" y="130"><name x="-130" y="100">Online</name><label kind="invariant" x="-130" y="145">x &lt;= HB</label></location>
<location id="Node_Down" x="-110" y="-130"><name x="-130" y="-160">Down</name></location>
<init ref="Node_Online"/>
<transition><source ref="Node_Starting"/><target ref="Node_Online"/><label kind="synchronisation" x="65" y="60">birth!</label></transition>
<transition><source ref="Node_Online"/><target ref="Node_Online"/><label kind="guard" x="-110" y="64">x &gt;= HB</label><label kind="synchronisation" x="-110" y="79">hb!</label><label kind="assignment" x="-110" y="94">x = 0</label><nail x="-70" y="80"/><nail x="-150" y="80"/></transition>
<transition><source ref="Node_Online"/><target ref="Node_Down"/><label kind="synchronisation" x="-100" y="23">crash?</label></transition>
<transition><source ref="Node_Online"/><target ref="Node_Down"/><label kind="synchronisation" x="-100" y="37">freeze?</label></transition>
<transition><source ref="Node_Down"/><target ref="Node_Starting"/><label kind="synchronisation" x="65" y="-14">restart?</label><label kind="assignment" x="65" y="1">x = 0</label></transition>
</template>
<template>
<name>Broker</name>
<declaration>clock y;</declaration>
<location id="Broker_Alive" x="220" y="0"><name x="200" y="-30">Alive</name><label kind="invariant" x="200" y="15">y &lt;= DEADAFTER</label></location>
<location id="Broker_Notify" x="-110" y="130"><name x="-130" y="100">Notify</name><committed/></location>
<location id="Broker_Dead" x="-110" y="-130"><name x="-130" y="-160">Dead</name></location>
<init ref="Broker_Alive"/>
<transition><source ref="Broker_Alive"/><target ref="Broker_Alive"/><label kind="synchronisation" x="220" y="-65">hb?</label><label kind="assignment" x="220" y="-50">y = 0</label><nail x="260" y="-50"/><nail x="180" y="-50"/></transition>
<transition><source ref="Broker_Alive"/><target ref="Broker_Notify"/><label kind="synchronisation" x="65" y="74">crash?</label></transition>
<transition><source ref="Broker_Notify"/><target ref="Broker_Dead"/><label kind="synchronisation" x="-100" y="23">ndeath!</label></transition>
<transition><source ref="Broker_Alive"/><target ref="Broker_Dead"/><label kind="guard" x="65" y="-43">y &gt;= DEADAFTER</label><label kind="synchronisation" x="65" y="-28">ndeath!</label></transition>
<transition><source ref="Broker_Dead"/><target ref="Broker_Alive"/><label kind="synchronisation" x="65" y="-14">birth?</label><label kind="assignment" x="65" y="1">y = 0</label></transition>
</template>
<template>
<name>MON</name>
<declaration>clock z;</declaration>
<location id="MON_Watching" x="220" y="0"><name x="200" y="-30">Watching</name></location>
<location id="MON_Failed" x="-110" y="130"><name x="-130" y="100">Failed</name><label kind="invariant" x="-130" y="145">z &lt;= ESCALATE</label></location>
<location id="MON_Escalated" x="-110" y="-130"><name x="-130" y="-160">Escalated</name></location>
<init ref="MON_Watching"/>
<transition><source ref="MON_Watching"/><target ref="MON_Failed"/><label kind="synchronisation" x="65" y="60">ndeath?</label><label kind="assignment" x="65" y="75">z = 0</label></transition>
<transition><source ref="MON_Failed"/><target ref="MON_Watching"/><label kind="synchronisation" x="65" y="74">birth?</label></transition>
<transition><source ref="MON_Failed"/><target ref="MON_Escalated"/><label kind="guard" x="-100" y="8">z &gt;= ESCALATE</label><label kind="synchronisation" x="-100" y="23">escalate!</label></transition>
</template>
<template>
<name>Docker</name>
<declaration>clock d;</declaration>
<location id="Docker_Idle" x="220" y="0"><name x="200" y="-30">Idle</name></location>
<location id="Docker_Restarting" x="-220" y="0"><name x="-240" y="-30">Restarting</name><label kind="invariant" x="-240" y="15">d &lt;= RDMAX</label></location>
<init ref="Docker_Idle"/>
<transition><source ref="Docker_Idle"/><target ref="Docker_Restarting"/><label kind="synchronisation" x="10" y="-5">ndeath?</label><label kind="assignment" x="10" y="10">d = 0</label></transition>
<transition><source ref="Docker_Restarting"/><target ref="Docker_Idle"/><label kind="guard" x="10" y="-6">d &gt;= RDMIN</label><label kind="synchronisation" x="10" y="9">restart!</label></transition>
</template>
<template>
<name>Env</name>
<declaration></declaration>
<location id="Env_Idle" x="220" y="0"><name x="200" y="-30">Idle</name></location>
<location id="Env_Faulted" x="-220" y="0"><name x="-240" y="-30">Faulted</name></location>
<init ref="Env_Idle"/>
<transition><source ref="Env_Idle"/><target ref="Env_Faulted"/><label kind="synchronisation" x="10" y="-5">crash!</label><label kind="assignment" x="10" y="10">t = 0</label></transition>
<transition><source ref="Env_Idle"/><target ref="Env_Faulted"/><label kind="synchronisation" x="10" y="9">freeze!</label><label kind="assignment" x="10" y="24">t = 0</label></transition>
</template>
<system>system Node, Broker, MON, Docker, Env;</system>
</nta>
