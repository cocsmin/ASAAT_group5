<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd'>
<nta>
<declaration>const int GRACE = 3;      // station.HandoverGrace
const int RECONCILE = 5;  // station.ReconcileEvery
const int DELMAX = 1;     // message delivery, estimated
bool stored = false, adopted = false;
clock a;                  // time since the document was stored
chan handoff, deliver;
</declaration>
<template>
<name>Sender</name>
<declaration></declaration>
<location id="Sender_Idle" x="220" y="0"><name x="200" y="-30">Idle</name></location>
<location id="Sender_Stored" x="-110" y="130"><name x="-130" y="100">Stored</name><committed/></location>
<location id="Sender_Signalled" x="-110" y="-130"><name x="-130" y="-160">Signalled</name></location>
<init ref="Sender_Idle"/>
<transition><source ref="Sender_Idle"/><target ref="Sender_Stored"/><label kind="assignment" x="65" y="75">stored = true, a = 0</label></transition>
<transition><source ref="Sender_Stored"/><target ref="Sender_Signalled"/><label kind="synchronisation" x="-100" y="9">handoff!</label></transition>
</template>
<template>
<name>Message</name>
<declaration>clock m;</declaration>
<location id="Message_Idle" x="220" y="0"><name x="200" y="-30">Idle</name></location>
<location id="Message_Flight" x="0" y="150"><name x="-20" y="120">Flight</name><label kind="invariant" x="-20" y="165">m &lt;= DELMAX</label></location>
<location id="Message_Lost" x="-220" y="0"><name x="-240" y="-30">Lost</name></location>
<location id="Message_Delivered" x="0" y="-150"><name x="-20" y="-180">Delivered</name></location>
<init ref="Message_Idle"/>
<transition><source ref="Message_Idle"/><target ref="Message_Flight"/><label kind="synchronisation" x="120" y="70">handoff?</label><label kind="assignment" x="120" y="85">m = 0</label></transition>
<transition><source ref="Message_Flight"/><target ref="Message_Delivered"/><label kind="synchronisation" x="10" y="9">deliver!</label></transition>
<transition><source ref="Message_Flight"/><target ref="Message_Lost"/></transition>
</template>
<template>
<name>Receiver</name>
<declaration>clock r;</declaration>
<location id="Receiver_Idle" x="220" y="0"><name x="200" y="-30">Idle</name><label kind="invariant" x="200" y="15">r &lt;= RECONCILE</label></location>
<location id="Receiver_Adopted" x="-220" y="0"><name x="-240" y="-30">Adopted</name></location>
<init ref="Receiver_Idle"/>
<transition><source ref="Receiver_Idle"/><target ref="Receiver_Adopted"/><label kind="synchronisation" x="10" y="-5">deliver?</label><label kind="assignment" x="10" y="10">adopted = true</label></transition>
<transition><source ref="Receiver_Idle"/><target ref="Receiver_Adopted"/><label kind="guard" x="10" y="-6">stored &amp;&amp; a &gt;= GRACE &amp;&amp; r &gt;= RECONCILE</label><label kind="assignment" x="10" y="24">adopted = true</label></transition>
<transition><source ref="Receiver_Idle"/><target ref="Receiver_Idle"/><label kind="guard" x="220" y="-52">!stored &amp;&amp; r &gt;= RECONCILE</label><label kind="assignment" x="220" y="-22">r = 0</label><nail x="260" y="-50"/><nail x="180" y="-50"/></transition>
<transition><source ref="Receiver_Idle"/><target ref="Receiver_Idle"/><label kind="guard" x="220" y="-38">stored &amp;&amp; a &lt; GRACE &amp;&amp; r &gt;= RECONCILE</label><label kind="assignment" x="220" y="-8">r = 0</label><nail x="260" y="-50"/><nail x="180" y="-50"/></transition>
</template>
<template>
<name>Tick</name>
<declaration></declaration>
<location id="Tick_On" x="220" y="0"><name x="200" y="-30">On</name></location>
<init ref="Tick_On"/>
<transition><source ref="Tick_On"/><target ref="Tick_On"/><nail x="260" y="-50"/><nail x="180" y="-50"/></transition>
</template>
<system>system Sender, Message, Receiver, Tick;</system>
</nta>
