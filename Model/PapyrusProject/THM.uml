  <Blocks:NestedConnectorEnd xmi:id="_Qb7OEsJNEfGQ8p8AWzIUhA" base_Element="_Qb7OEMJNEfGQ8p8AWzIUhA" propertyPath="_gRqZgIoMP0Sawp1GdY_eRQ" base_ConnectorEnd="_Qb7OEMJNEfGQ8p8AWzIUhA"/>
  <Requirements:Requirement xmi:id="_bf54kSdcgBjvlQStTQszXR" base_Class="_9Jgu8qDkTm3XOEcCNfj-b2" id="THM-REQ-01" text="The system shall accept finished batter together with its batch ID from Batter Preparation through the signal &quot;Batter ready&quot;."/>
  <Requirements:Requirement xmi:id="_LGE1U6VeO0osUxwcAJFPU_" base_Class="_IFkQ4UYZX83SQQb2KdsCuj" id="THM-REQ-02" text="The system shall detect whether a pan is present at the depositing point before it releases any batter."/>
  <Requirements:Requirement xmi:id="_EqNoiCy_ZodP8sqnGQPqXj" base_Class="_y19ugeE_d9aBvwjyOIDhgx" id="THM-REQ-03" text="When a pan is present at the depositing point, the system shall deposit the recipe-defined fixed amount of batter into that pan."/>
  <Requirements:Requirement xmi:id="_Q0UuUWIHkFsC7g10Pjakiv" base_Class="_KYlK7OwbemyVf1v8XvhrY9" id="THM-REQ-04" text="While no pan is present at the depositing point, the system shall withhold batter."/>
  <Requirements:Requirement xmi:id="_1SXyURHI3XoWUe-yGuAP_O" base_Class="_sP8i2z_DrOCrAtmnrFvlwl" id="THM-REQ-05" text="When no pan is present at the depositing point, the system shall send the signal &quot;Pan request&quot; to Finishing &amp; Packaging."/>
  <Requirements:Requirement xmi:id="_jF64VFOipl1fpRGpWKMA_8" base_Class="_9zwd6kRWwIocsXOXU9d-AL" id="THM-REQ-06" text="When a pan is detected after a pan request, the system shall resume depositing."/>
  <Requirements:Requirement xmi:id="_uevNNLbz-I202PtNZCZ6Yz" base_Class="_hM-uWQASJ6fdhC06v__Wj2" id="THM-REQ-07" text="The system shall weigh every filled pan."/>
  <Requirements:Requirement xmi:id="_Z03nJ0D4U6JE7CWWE7Eb_z" base_Class="_qwFgO5fr75Ib4oj2PxcOg2" id="THM-REQ-08" text="The system shall let a filled pan continue toward baking only if its weight is within the legal tolerance (EU rules for the average quantity) of the target fill weight."/>
  <Requirements:Requirement xmi:id="_CPCSfQRoDKvvvFDW7ipq57" base_Class="_8J1e5CAN4QfSEqrZi60VcM" id="THM-REQ-09" text="The system shall not start depositing while the fill-weight measurement is not calibrated."/>
  <Requirements:Requirement xmi:id="_iRqYK0hRipx8Ym1i6c_bQQ" base_Class="_5okMhwcgETRasOz0mlZCg6" id="THM-REQ-10" text="The system shall divert every filled pan whose weight is outside the tolerance off the band."/>
  <Requirements:Requirement xmi:id="_oXAZI8eNMChsTZD5YNASu_" base_Class="_qt43vnF_9VHX7KVuaqT2jy" id="THM-REQ-11" text="The system shall discard the batter of every diverted pan."/>
  <Requirements:Requirement xmi:id="_w258OPpCqotNUNR_uv7rxT" base_Class="_K5_zX_qJqckGWnanlmNQU0" id="THM-REQ-12" text="The system shall send every diverted pan to Finishing &amp; Packaging for washing through the signal &quot;Pan for washing&quot;."/>
  <Requirements:Requirement xmi:id="_h0Xc-7Te-sMkp0Fe-ahonX" base_Class="_2wmZiYWzEEGWFtPuiDSjgk" id="THM-REQ-13" text="The system shall publish a log event (reason, time, batch ID) for every wait for a pan and for every diverted pan."/>
  <Requirements:Requirement xmi:id="_MLU-JnlACAKCykxFL1ZKoK" base_Class="_aPsKTa6luDLBZvmAcADqe-" id="THM-REQ-14" text="The system shall accept clean pans together with the current clean-pan stock level through the signal &quot;Clean pan supply&quot;."/>
  <Requirements:Requirement xmi:id="_TlJ_O8oGQtzKthSbcpp_qk" base_Class="_NLbKgBrI0ctdbgpynQtNPR" id="THM-REQ-15" text="When the received clean-pan stock level is below the low-stock limit S_low, the system shall fill fewer pans."/>
  <Requirements:Requirement xmi:id="_-5PNaW3XcSCbPLHNguSGY3" base_Class="_3G_86TS1Mg5zEDa-xch1T5" id="THM-REQ-16" text="The system shall count the filled pans with out-of-tolerance weight in a row and reset the count when a filled pan is within tolerance."/>
  <Requirements:Requirement xmi:id="_ailcFHIDgFiXt1Ednx9I78" base_Class="_1Oroqkmn53lVhIg1Mxp973" id="THM-REQ-17" text="When the count reaches the limit N_wrong, the system shall stop depositing."/>
  <Requirements:Requirement xmi:id="_78RsmLKI5dH3b8g7ImSxQ8" base_Class="_se4hLp7O6XE473QyG_rCHw" id="THM-REQ-18" text="When depositing is stopped because the count reached N_wrong, the system shall publish an error event so that the Health Monitor notifies Maintenance."/>
  <Requirements:Requirement xmi:id="_ymtIrYb-EiHMvYvssCBnbG" base_Class="_QSnWMv2W6TYXr9GUF0ugZ5" id="THM-REQ-19" text="The system shall resume depositing after a repeated-failure stop only after it has received the signal &quot;Repair confirmed&quot; for the depositing equipment."/>
  <Requirements:Requirement xmi:id="_T0GRjHKiqZpy8TQc8-8ZB1" base_Class="_tMD8IxICy-Ld9KcfUZIBGr" id="THM-REQ-20" text="The system shall send the signal &quot;Depositing stopped / working again&quot; to Batter Preparation whenever depositing stops and whenever it resumes."/>
  <Requirements:Requirement xmi:id="_QMpwwHYPC6uWzkLo5IqO5X" base_Class="_qR7i1xY1x-FqBWdVNgl0kS" id="THM-REQ-21" text="When a baking zone is flagged faulty, the system shall stop admitting new pans at depositing."/>
  <Requirements:Requirement xmi:id="_IMkYAzsPeoqI9x3gGqj-5G" base_Class="_f3Fd38Dov4rfy6i8gqBCZ3" id="THM-REQ-22" text="While new pans are stopped because of a zone fault, the system shall let the pans already inside the baking tunnel finish baking and be checked at tunnel exit."/>
  <Requirements:Requirement xmi:id="_d_O4CgpAh9uHkco4UfELtp" base_Class="__LCgmJQ5_quP3Ae0N4TFfa" id="THM-REQ-23" text="When the cooling buffer management reports that the cooling buffer is full, the system shall stop admitting new pans at depositing."/>
  <Requirements:Requirement xmi:id="_A2SX5M28TorfzEK8-hkepW" base_Class="_YBYbx0lXfmMiX9mJqraNPN" id="THM-REQ-24" text="When the signal &quot;Stop / resume pan admission&quot; says stop, the system shall stop admitting new pans at depositing."/>
  <Requirements:Requirement xmi:id="_P1Uvw8sot7culD28G86-K7" base_Class="_PJwkMIHVDgijL9Fj03j_i9" id="THM-REQ-25" text="The system shall resume admitting new pans only when no stop reason remains active (zone fault, buffer full, stop from Finishing &amp; Packaging, repeated-failure stop, band halt)."/>
  <Requirements:Requirement xmi:id="_4s97c2PQtaKuYr-_nk-A-L" base_Class="__YmRRmUnYa8sjX3Ba7Yp3U" id="THM-REQ-26" text="The system shall regulate the temperature of each baking zone to its setpoint in real time with a local control loop."/>
  <Requirements:Requirement xmi:id="_jL8HpHsGz4NqMVR2zpOGDX" base_Class="_C7N_6SjAExmQVfPHN14Eey" id="THM-REQ-27" text="The system shall keep regulating the zone temperatures while any pan is inside the baking tunnel, also while depositing is stopped."/>
  <Requirements:Requirement xmi:id="_BL2ArNVBCY0vHDrPZUPjya" base_Class="_Os1S_Ntqdle_cCnpTTNV30" id="THM-REQ-28" text="When a zone temperature is outside its range, the system shall adjust the heating of that zone."/>
  <Requirements:Requirement xmi:id="_YTOou7LG_OyxlKH3pVYjbI" base_Class="_4aV_RwBLhPy4k3pKJs0mGD" id="THM-REQ-29" text="When a zone temperature is still out of range after the adjustment time T_adjust, the system shall flag the zone as faulty."/>
  <Requirements:Requirement xmi:id="_q5mBQKpnOyyqHcKvDJH8UA" base_Class="_SHBqfQS_OdomOxrYC3iOzs" id="THM-REQ-30" text="When a zone is flagged faulty, the system shall publish an error event so that the Health Monitor notifies Maintenance."/>
  <Requirements:Requirement xmi:id="_J6sCQYTbIW5s2Reh_I2y8K" base_Class="_Awx0ek1BDi_SAww8l4p4sX" id="THM-REQ-31" text="The system shall clear the faulty flag of a zone only after it has received the signal &quot;Repair confirmed&quot; for that zone and the zone temperature is within range."/>
  <Requirements:Requirement xmi:id="_xED_TFiqxsZUgwpPMp0sMY" base_Class="_rzPARlM2hkbwCfvTN9GfYO" id="THM-REQ-32" text="The system shall measure the internal temperature of every cake leaving the baking tunnel."/>
  <Requirements:Requirement xmi:id="_ZiL_43jfmXKI_ITBURuApv" base_Class="_gfKfwgHmzwtYh_OtoPJRIM" id="THM-REQ-33" text="The system shall let a cake continue to cooling only if its internal temperature is 97 °C ± 0.5 °C."/>
  <Requirements:Requirement xmi:id="_N9wbw8KbsVeQB9gR0Kic-B" base_Class="_Y3e2Vb9UvTsFms0DPMN3Sf" id="THM-REQ-34" text="The system shall divert every cake whose internal temperature is outside 97 °C ± 0.5 °C to the refuse path."/>
  <Requirements:Requirement xmi:id="_pbhoPkenRFEsgNJ4PxGyQX" base_Class="_Mv1witVSU4vP9GwyvrAYmt" id="THM-REQ-35" text="The system shall publish a discard event (reason &quot;undercooked&quot; or &quot;overcooked&quot;, time, batch ID) for every cake diverted because of its temperature."/>
  <Requirements:Requirement xmi:id="_xzi6WNP9islq_RxyvLcHxM" base_Class="_B9X3XmtWd7_Eo1Y5wrX5Em" id="THM-REQ-36" text="When the temperature measurement at tunnel exit delivers no valid reading within T_resp, the system shall divert every cake leaving the baking tunnel to the refuse path."/>
  <Requirements:Requirement xmi:id="_cOjCaBusDzPqjD6F-EOe9C" base_Class="_Uu18kwRb4k1h1geAbavV1u" id="THM-REQ-37" text="The system shall publish a discard event (reason &quot;cannot be checked&quot;, time, batch ID) for every cake diverted because no temperature reading is available."/>
  <Requirements:Requirement xmi:id="_ZtLiXaTWfMy7T-ZSJRgbSu" base_Class="_eSThUVU6fDRfRd6pIAbXwn" id="THM-REQ-38" text="When the temperature measurement at tunnel exit stops responding, the system shall publish an error event so that the Health Monitor notifies Maintenance."/>
  <Requirements:Requirement xmi:id="_wdMGJftL1tY1mxUQBr8JJm" base_Class="_PVzLj7Yv85JnSjrviTc-hs" id="THM-REQ-39" text="The system shall resume the normal 100% check only after it has received the signal &quot;Repair confirmed&quot; for the temperature measurement at tunnel exit."/>
  <Requirements:Requirement xmi:id="__M6aJ4slSCe8OofAOQ2yow" base_Class="_l6k5EPAd7YaGJ0W23NMqQB" id="THM-REQ-40" text="The system shall control the cooling so that every cake passing the cooling zone is cooled to the safe temperature T_safe."/>
  <Requirements:Requirement xmi:id="_OKTSmpomx4F9JT6-JZSG3t" base_Class="__oS7LtMOtCre-ieS8DzeSx" id="THM-REQ-41" text="The system shall measure the core temperature of every cake at the exit of the cooling zone."/>
  <Requirements:Requirement xmi:id="_aw9m-_65Pz65W72xdWkmwb" base_Class="_A11wbC-bcJ0c82-DHUL3Cr" id="THM-REQ-42" text="When the core temperature of a cake is at or below T_safe, the system shall release the cake with its batch ID to Finishing &amp; Packaging through the signal &quot;Cooled cake&quot;."/>
  <Requirements:Requirement xmi:id="_luQIIZSd5Zhelptt8lNtcz" base_Class="_VJA7lWbT8KYmbR00RcQlnr" id="THM-REQ-43" text="The system shall not release to Finishing &amp; Packaging any cake whose core temperature is above T_safe."/>
  <Requirements:Requirement xmi:id="_lR-qnLWfOKfi809W3UZ5ES" base_Class="_J_75cYsrKrvQrPr3ir2Nct" id="THM-REQ-44" text="When the core temperature of a cake at the cooling exit is above T_safe, the system shall increase the cooling."/>
  <Requirements:Requirement xmi:id="_JSYAeO2JuU4JGta4gkOrT8" base_Class="_BtY_G5OtN1aCtkK1UXkruj" id="THM-REQ-45" text="When a cake is still above T_safe after the cooling was increased, the system shall route it to the cooling buffer (waiting zone)."/>
  <Requirements:Requirement xmi:id="_HzyaA0lf3GdnyhR6gUAPmB" base_Class="_l58CPQsGW-2MFKlRB2qUQG" id="THM-REQ-46" text="When cooling has stopped working, the system shall route new cakes to the cooling buffer."/>
  <Requirements:Requirement xmi:id="_Unw-4fkUwwYPvPaufhjfgg" base_Class="_AS8765EMhG01F4ehO8RzxV" id="THM-REQ-47" text="The system shall let the cakes that are inside the cooling zone when cooling fails finish the zone and then send them to the cooling buffer."/>
  <Requirements:Requirement xmi:id="_LpOit6LkzBF0Kv2hnPks_u" base_Class="_8uM40o3EW0_yTxLSDIOwOq" id="THM-REQ-48" text="The system shall hold the cakes in the cooling buffer until cooling is repaired."/>
  <Requirements:Requirement xmi:id="_YG9iealaZ2oBJPnmMKrfxC" base_Class="_qS4IvNsM7qLlcoaJhaH9iX" id="THM-REQ-49" text="When cooling has stopped working, the system shall publish an error event so that the Health Monitor notifies Maintenance."/>
  <Requirements:Requirement xmi:id="__WwEvYoP3BAWmAfm4kIzpS" base_Class="_8WofiBjezUMyJpcoO2qd3b" id="THM-REQ-50" text="When the signal &quot;Repair confirmed&quot; for the cooling zone is received, the system shall route new cakes to the cooling zone again."/>
  <Requirements:Requirement xmi:id="_zVi7vBgXB9vhVga_Gv4h6N" base_Class="_a5L6qKdzHTc3IlzWj93_mj" id="THM-REQ-51" text="Once cooling works again and new cakes are sent to cooling, the system shall release the buffered cakes one by one in their order of arrival."/>
  <Requirements:Requirement xmi:id="_613cWHAxqIT3QJpBKvQR_Z" base_Class="_lxTCRgOqwqtXo_HYa8sTgi" id="THM-REQ-52" text="The system shall measure the core temperature of every released cake and send it to Finishing &amp; Packaging as &quot;Cooled cake&quot; if it is at or below T_safe, otherwise through the cooling zone again."/>
  <Requirements:Requirement xmi:id="_uzcjKdWkXCUg3GXHaNhTCY" base_Class="_w7yRhl1g8t5R0wbewn5GaZ" id="THM-REQ-53" text="The system shall track the waiting time of every cake in the cooling buffer."/>
  <Requirements:Requirement xmi:id="_LaMwfx28cJh8WPgGOf8qUU" base_Class="_FcxITRdaukJgvjGt0PNmlW" id="THM-REQ-54" text="When the waiting time of a cake in the cooling buffer exceeds T_wait (default 30 minutes), the system shall move the cake to the refuse path."/>
  <Requirements:Requirement xmi:id="_7__nlyTF2eQ0T6-3L6daQp" base_Class="_fZyxL60n2_TvZ4VRJyKVwL" id="THM-REQ-55" text="The system shall publish a discard event (reason &quot;waited too long&quot;, time, batch ID) for every cake moved out of the cooling buffer because of its waiting time."/>
  <Requirements:Requirement xmi:id="_FNwFU_v8OA2AxNwOuvEt-C" base_Class="_oxCUZfcsazNdfNCtmpBRA4" id="THM-REQ-56" text="When more than 30 minutes pass between a cooling failure and its repair, the system shall move all cakes on the cooling conveyor and in the waiting zone to the refuse path."/>
  <Requirements:Requirement xmi:id="_WRkOs83_c2_rALmB_PTqb_" base_Class="_U0pesySANq2jym-hj1-48c" id="THM-REQ-57" text="When the cooling buffer has no free place left, the system shall report &quot;buffer full&quot; to Depositing Control and to the Tunnel-Exit Controller."/>
  <Requirements:Requirement xmi:id="_NcL_29vy558KucG6-eIc1A" base_Class="_7i--A45bhI4uN2pS2X3g_U" id="THM-REQ-58" text="When the cooling buffer is full, the system shall divert the cakes that are still leaving the baking tunnel to the refuse path."/>
  <Requirements:Requirement xmi:id="_CezIgV35nL4CAgMhTDfHAn" base_Class="_RUCja6QQL7yvdROQSpoA1e" id="THM-REQ-59" text="The system shall publish a discard event (reason &quot;buffer full&quot;, time, batch ID) for every cake diverted because the cooling buffer is full."/>
  <Requirements:Requirement xmi:id="__SyxcbwpTR3M16ug2IvCnU" base_Class="_HUhW42Y8Xb1o3HFlZ4XcdR" id="THM-REQ-60" text="The system shall resume depositing after a buffer-full stop only after cooling is repaired (&quot;Repair confirmed&quot; for the cooling zone) and the cooling buffer has free places."/>
  <Requirements:Requirement xmi:id="_x9RK6cxAY1Ne4q6NnQTrr0" base_Class="_btDjgIFjZVpsXR7GbKW0Aa" id="THM-REQ-61" text="Where no cooling buffer is installed, the system shall route new cakes to the refuse path when cooling stops."/>
  <Requirements:Requirement xmi:id="_Wn3qKjg8MS-yJE2_JDWxC1" base_Class="_Erw-PNo-ANcI9dEEkLaLaE" id="THM-REQ-62" text="Where no cooling buffer is installed, the system shall send a cake that is still above T_safe after the cooling was increased to the refuse path and publish a discard event (reason &quot;too hot&quot;, time, batch ID)."/>
  <Requirements:Requirement xmi:id="_ufEVxfNbGuthJwR254BjMH" base_Class="_LK2c-YKT41JToXLiUK5Hx-" id="THM-REQ-63" text="The system shall publish log events with time and, where known, batch ID to Line Monitoring through the signal &quot;Log, warning, error and discard events&quot;."/>
  <Requirements:Requirement xmi:id="_R_i1yDZlPsqhsu0vDzKRTx" base_Class="_3eFu0nowhZ1nUbfg6MI0Rm" id="THM-REQ-64" text="Each controller of the slice shall publish its own status and the status of its devices through the signal &quot;Machine status (heartbeat)&quot; at a regular interval T_hb."/>
  <Requirements:Requirement xmi:id="_EUTApkT701mYd85joexiri" base_Class="_SuT-1R3IyrJmNxnMndGtkn" id="THM-REQ-65" text="When it receives the notification for a band halt, the system shall stop admitting new pans and shall keep zone control, exit inspection and cooling control running for the product already inside."/>
  <Requirements:Requirement xmi:id="_B3YgglmOvAori22ByxWVox" base_Class="_LldUMLSoyA41bs319uIHpC" id="THM-REQ-66" text="When it receives the notification for a slow-down, the system shall continue working at the reduced band speed and keep inspecting every cake."/>
  <Requirements:Requirement xmi:id="_WfzW190UJ39SJrGeu9BtwY" base_Class="_zQZ1uwLX5ShPds52agVT79" id="THM-REQ-67" text="When it receives the notification for a restart, the system shall resume normal operation and admit new pans again as soon as no other stop reason is active (THM-REQ-25)."/>
  <Requirements:Requirement xmi:id="_jcy4-wi7JcoLL2-EPsLzW3" base_Class="_vZvXUIosjlUZZQe9yvyiEt" id="THM-REQ-68" text="The system shall receive the signal &quot;Repair confirmed&quot; (machine, repaired) and give the owning controller the permission to resume."/>
  <Requirements:Requirement xmi:id="_h6w1kQkoZrZ2GDKa7y5sYx" base_Class="_M_UTQXUzqCPhz8qP_fq-zL" id="THM-REQ-69" text="When a function of the slice enters degraded operation (a zone is being adjusted, cooling had to be increased, the cooling buffer is nearly full), the system shall publish a warning event to Line Monitoring through the signal &quot;Log, warning, error and discard events&quot;."/>
  <Requirements:Requirement xmi:id="_uIax-YE-rWZhi-hV28R0Lr" base_Class="_b6nuDkdaSqtaJJri5V6TFN" id="THM-REQ-70" text="When a function of the slice needs Maintenance or a halt of production, the system shall publish an error event to Line Monitoring through the signal &quot;Log, warning, error and discard events&quot;."/>
  <Requirements:Requirement xmi:id="_Nu7mJ71LWZjVye7mRpmL2p" base_Class="_Kgt5KuuOwKKxuqn08AJjuj" id="THM-REQ-71" text="NFR (availability): the controllers of the slice shall be available 24/7 with a monthly availability of at least 99.5 % (proposed value)."/>
  <Requirements:Requirement xmi:id="_ETruHsnUGHEMxVV0fARZft" base_Class="_HqAO3Pmnj0wKc2IvAkSkcJ" id="THM-REQ-72" text="NFR (detection time): the system shall detect a stopped controller or device of the slice within 3 heartbeat intervals, i.e. within 15 s with T_hb = 5 s (proposed values)."/>
  <Requirements:Requirement xmi:id="_a-1jaEcOHKBGJEj6uy9-_G" base_Class="_l1CCYTe6OXlKdj7qznmQeS" id="THM-REQ-73" text="NFR (recovery time): after &quot;Repair confirmed&quot; is received, the affected function shall be back in normal operation within 60 s (proposed value)."/>
  <Requirements:Requirement xmi:id="_lphSnyBs9XB9kbb3DOBM87" base_Class="_GsKwHM7W1QXtxUVOAB-y-p" id="THM-REQ-74" text="NFR (continuity): zone temperature control shall have no interruption (0 s) while product is inside the baking tunnel, also during deployment, restart of other functions and band halt."/>
  <Requirements:Requirement xmi:id="_VWqPt5pH5yC9_9nv5_Bc9a" base_Class="_6k5nr7N3F_w2I3rNiKJBzN" id="THM-REQ-75" text="NFR (accuracy): the measurement of the internal cake temperature at tunnel exit shall have an uncertainty of at most 0.1 °C (proposed value)."/>
  <Requirements:Requirement xmi:id="_KYtnQfMt3Mr3G0ahqnSZUk" base_Class="_dgcv_gUHVMgLwXQj7vPdk8" id="THM-REQ-76" text="NFR (reaction time): new pans shall stop being admitted within 1 s after a stop reason arises (proposed value)."/>
  <Requirements:Requirement xmi:id="_FIycoHi27hPCQMkpoS-_uh" base_Class="_NeatzRpO7tcXO28PPS4-hY" id="THM-REQ-77" text="NFR (traceability): 100 % of discarded cakes shall have a discard event (reason, time, batch ID) published within 5 s of the discard (proposed value)."/>
  <Requirements:Requirement xmi:id="_A4fEqT441QmdIILZmCC0Rr" base_Class="_c_RNwuMQt8gUNg7qITtYvC" id="THM-REQ-78" text="NFR (reaction time): the slice shall react to a &quot;Band state change&quot; within 1 s (proposed value)."/>
  <Requirements:Requirement xmi:id="_ijheNwHSVG2iObnhO_v91T" base_Class="_l1SSvrnYBKWMuwTllMO5wp" id="FIN-REQ-02" text="The system shall accept for depanning only cakes that Thermal Processing has released as having reached the safe internal temperature."/>
