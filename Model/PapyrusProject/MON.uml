  <Requirements:Requirement xmi:id="_ZFvHYNICEfGKVdaTCg46lw" base_NamedElement="_ZFiTENICEfGKVdaTCg46lw" id="MON-REQ-01" text="The MON subsystem shall monitor equipment health using sensor data and provide health status information and alerts when abnormal conditions are detected." base_Class="_ZFiTENICEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_K5G0INIDEfGKVdaTCg46lw" base_NamedElement="_K5Dw0NIDEfGKVdaTCg46lw" id="MON-REQ-02" text="The MON subsystem shall record production events, equipment status changes, and traceability information to support operational monitoring and historical analysis." base_Class="_K5Dw0NIDEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_bsTEgNIDEfGKVdaTCg46lw" base_NamedElement="_bsQBMNIDEfGKVdaTCg46lw" id="MON-REQ-03" text="The MON subsystem shall support maintenance management by generating maintenance requests based on equipment health alerts and tracking the status of maintenance activities." base_Class="_bsQBMNIDEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_lDO-sNIDEfGKVdaTCg46lw" base_NamedElement="_lDMicNIDEfGKVdaTCg46lw" id="MON-REQ-04" text="The MON subsystem shall monitor container status and health, detect abnormal container conditions, and generate alerts when intervention is required." base_Class="_lDMicNIDEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_z2szANIDEfGKVdaTCg46lw" base_NamedElement="_z2q90NIDEfGKVdaTCg46lw" id="MON-REQ-05" text="The MON subsystem shall provide a message bus to exchange event data, health alerts, container alerts, maintenance requests, and maintenance status information between its components." base_Class="_z2q90NIDEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_PIV_QNIEEfGKVdaTCg46lw" base_NamedElement="_PIS78NIEEfGKVdaTCg46lw" id="MON-REQ-06" text="The MON subsystem shall store event logs and traceability data in a database and support the retrieval of historical records in response to log queries." base_Class="_PIS78NIEEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_ZhgygNIEEfGKVdaTCg46lw" base_NamedElement="_ZheWQNIEEfGKVdaTCg46lw" id="MON-REQ-7" text="The MON subsystem shall provide an overseer dashboard to display equipment health status, container status, maintenance status, and historical log information retrieved from the database." base_Class="_ZheWQNIEEfGKVdaTCg46lw"/>
