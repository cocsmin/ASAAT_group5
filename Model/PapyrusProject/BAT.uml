          <subvertex xmi:type="uml:State" xmi:id="_Vn-9XXD8SLuigoek5jDd0P" name="Dispensing">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_xE93YyiKR86VVIhJSSwFd3" name="dispense ingredient toward its recipe target"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_Gy1SQFZ0n_BUvP7GjXXgkd" name="select next ingredient from recipe"/>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_e0fRRFVhGk_0W6vYrsOjLK" name="stop dispenser"/>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_tniIuNOVa0zgNEC6xx_7lW" name="Weighing">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_9qYG4JGq78unKFtoVxXuns" name="judge the measured weight against the recipe target and tolerance (P1)"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_dGs7V3rA5hqt5_ifbrcZag" name="read the load cell for the dispensed ingredient"/>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_UjazwcrU-nNm4aHyWvnfXh" name="publish dose result"/>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_RmptYd4_B8qrwqS0_td-BP" name="ToppingUp">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_LIBWmN8OAERHbJ-VZ9xWy7" name="request the missing amount"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_iVv8P2D4-Nms-yReAe5bOl" name="shortfall := recipe target - measured weight"/>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_FOEn84eQ77PLa1e7FjtAXZ" name="stop dispenser"/>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_WxIPONWgbiCQ2Mvd6xcUxL" name="Discarding">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_Ccfiv642KhGaOiJhKF42zb" name="open discard chute and dump the batch"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_trc4Y1V_YfVUMHWEI5qp58" name="record discard with reason and batch ID"/>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_eBdyPme2FmDaAOy7D2l4A_" name="close discard chute"/>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_axFaJOYpr_N3fgh_yxU0dI" name="BatchReady">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_kWf-orpUfpy3sDMiDLgYl2" name="hold the batch for mixing"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_n8nIHN8Xv_UFfgoRR2CTl6" name="mark batch loading complete"/>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_O-21yTHR74VdSnEGKB1wsd" name="Locked">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_yenLN0FmXxh_Lv2BQA8Pj7" name="wait for the doser to be marked operational"/>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_zqYJK51rKSmqJFhfqWIMsK" name="stop dosing and record error with batch ID"/>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_6DfkoM9bhAhsRNlUmUd590" name="consecutive failure count := 0"/>
          </subvertex>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_zWDnvHpNeHzxcXG_39UUqJ" name="Initial"/>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_naIAJyoGXcS3BeMJTkO3Xu" name="DoseCheck" kind="choice"/>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_04h-sjGlEE97k7ruZ2Me03" name="FailCheck" kind="choice"/>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_NWDQ4ua6IcIxat45AZBpAh" name="NewBatch" kind="junction"/>
          <subvertex xmi:type="uml:FinalState" xmi:id="_9e0bTrl9qcoOyAtNoMmE9Y" name="Batch closed"/>
        </region>
      </ownedBehavior>
      <ownedOperation xmi:type="uml:Operation" xmi:id="_DbbnAYVU9Vu25kwHv0a78g" name="startBatch"/>
