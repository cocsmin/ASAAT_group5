  <Requirements:TestCase xmi:id="_oXng0MyCEfGts8WNJoPXrQ" base_Behavior="_iisU0MyCEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_5bFFAMyGEfGts8WNJoPXrQ" base_NamedElement="_5bAMgMyGEfGts8WNJoPXrQ" id="BAT-REQ-01" text="The system shall receive the production order and its recipe targets from Production &amp; Logistics Management before dosing begins." base_Class="_5bAMgMyGEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_XSic8MyHEfGts8WNJoPXrQ" base_NamedElement="_XSdkcMyHEfGts8WNJoPXrQ" id="BAT-REQ-02" text="The system shall associate every batch with the batch ID of its production order, from intake until the batter is handed off to Thermal Processing." base_Class="_XSdkcMyHEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_iP7-oMyHEfGts8WNJoPXrQ" base_NamedElement="_iP47UMyHEfGts8WNJoPXrQ" id="BAT-REQ-03" text="The system shall request the ingredients required by the production order from Production &amp; Logistics Management, and shall not begin dosing until the request has been confirmed." base_Class="_iP47UMyHEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_rZVzIMyHEfGts8WNJoPXrQ" base_NamedElement="_rZRhsMyHEfGts8WNJoPXrQ" id="BAT-REQ-04.1" text="The system shall dispense each ingredient of the recipe into the mixer." base_Class="_rZRhsMyHEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_xa67EMyHEfGts8WNJoPXrQ" base_NamedElement="_xa2CkMyHEfGts8WNJoPXrQ" id="BAT-REQ-04.2" text="The system shall measure the dispensed weight of each ingredient." base_Class="_xa2CkMyHEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_2avrEMyHEfGts8WNJoPXrQ" base_NamedElement="_2arZoMyHEfGts8WNJoPXrQ" id="BAT-REQ-04.3" text="The system shall compare each measured weight against its recipe target." base_Class="_2arZoMyHEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_F_o8UMyIEfGts8WNJoPXrQ" base_NamedElement="_F_kq4MyIEfGts8WNJoPXrQ" id="BAT-REQ-05" text="The system shall treat a batch as ready for mixing only when every ingredient of the recipe is within the dose tolerance (P1) of its recipe target." base_Class="_F_kq4MyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_OigVQMyIEfGts8WNJoPXrQ" base_NamedElement="_OibcwMyIEfGts8WNJoPXrQ" id="BAT-REQ-06.1" text="The system shall request the missing amount of an ingredient when its measured weight is below the recipe target." base_Class="_OibcwMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_aHATMMyIEfGts8WNJoPXrQ" base_NamedElement="_aG8BwMyIEfGts8WNJoPXrQ" id="BAT-REQ-06.2" text="The system shall weigh an ingredient again after every top-up." base_Class="_aG8BwMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_eUbV4MyIEfGts8WNJoPXrQ" base_NamedElement="_eUWdYMyIEfGts8WNJoPXrQ" id="BAT-REQ-07.1" text="The system shall discard the batch when the measured weight of an ingredient exceeds its recipe target." base_Class="_eUWdYMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_prD28MyIEfGts8WNJoPXrQ" base_NamedElement="_pq_lgMyIEfGts8WNJoPXrQ" id="BAT-REQ-07.2" text="The system shall record a discard, with its reason and the batch ID, for every batch discarded because of an over-dose." base_Class="_pq_lgMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_yakkwMyIEfGts8WNJoPXrQ" base_NamedElement="_yagTUMyIEfGts8WNJoPXrQ" id="BAT-REQ-07.3" text="The system shall start a new batch after discarding an over-dosed batch." base_Class="_yagTUMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="__2JZEMyIEfGts8WNJoPXrQ" base_NamedElement="__2EgkMyIEfGts8WNJoPXrQ" id="BAT-REQ-08.1" text="The system shall count consecutive failed dose measurements." base_Class="__2EgkMyIEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_FCNOQMyJEfGts8WNJoPXrQ" base_NamedElement="_FCIVwMyJEfGts8WNJoPXrQ" id="BAT-REQ-08.2" text="The system shall stop dosing when the number of consecutive failed dose measurements reaches the maximum (P2)." base_Class="_FCIVwMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_MAa9kMyJEfGts8WNJoPXrQ" base_NamedElement="_MAWFEMyJEfGts8WNJoPXrQ" id="BAT-REQ-08.3" text="The system shall record an error, with the batch ID, when dosing is stopped because the maximum consecutive failed dose measurements (P2) was reached." base_Class="_MAWFEMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_Z0JMIMyJEfGts8WNJoPXrQ" base_NamedElement="_Z0E6sMyJEfGts8WNJoPXrQ" id="BAT-REQ-08.4" text="The system shall resume dosing only after the doser has been marked operational again." base_Class="_Z0E6sMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_u4a3MMyJEfGts8WNJoPXrQ" base_NamedElement="_u4V-sMyJEfGts8WNJoPXrQ" id="BAT-REQ-09.1" text="The system shall start the mixing cycle when batch loading is complete." base_Class="_u4V-sMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_z2SfYMyJEfGts8WNJoPXrQ" base_NamedElement="_z2Nm4MyJEfGts8WNJoPXrQ" id="BAT-REQ-09.2" text="The system shall run every mixing cycle for the recipe-defined duration." base_Class="_z2Nm4MyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_5VmnwMyJEfGts8WNJoPXrQ" base_NamedElement="_5VjkcMyJEfGts8WNJoPXrQ" id="BAT-REQ-10" text="The system shall monitor batter consistency throughout the mixing cycle." base_Class="_5VjkcMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_9XK_wMyJEfGts8WNJoPXrQ" base_NamedElement="_9XGuUMyJEfGts8WNJoPXrQ" id="BAT-REQ-11.1" text="The system shall present every finished batch to a human inspector before release." base_Class="_9XGuUMyJEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_CkEicMyKEfGts8WNJoPXrQ" base_NamedElement="_Cj_p8MyKEfGts8WNJoPXrQ" id="BAT-REQ-11.2" text="The system shall not release a batch for handoff until that batch has been marked good." base_Class="_Cj_p8MyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_Gu49EMyKEfGts8WNJoPXrQ" base_NamedElement="_Gu0roMyKEfGts8WNJoPXrQ" id="BAT-REQ-11.3" text="The system shall schedule a further mixing cycle immediately for every batch that is not marked good." base_Class="_Gu0roMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_MqBewMyKEfGts8WNJoPXrQ" base_NamedElement="_MqAQoMyKEfGts8WNJoPXrQ" id="BAT-REQ-12" text="The system shall make a batch available to Thermal Processing for depositing, together with its batch ID, once that batch has been marked good." base_Class="_MqAQoMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_Vx5pQMyKEfGts8WNJoPXrQ" base_NamedElement="_Vx1-4MyKEfGts8WNJoPXrQ" id="BAT-REQ-13.1" text="The system shall stop the mixer when a mixer fault is detected." base_Class="_Vx1-4MyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_aN2QIMyKEfGts8WNJoPXrQ" base_NamedElement="_aNx-sMyKEfGts8WNJoPXrQ" id="BAT-REQ-13.2" text="The system shall discard the batch that is in the mixer when a mixer fault is detected." base_Class="_aNx-sMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_epSgsMyKEfGts8WNJoPXrQ" base_NamedElement="_epPdYMyKEfGts8WNJoPXrQ" id="BAT-REQ-13.3" text="The system shall record an error, with the batch ID, when a mixer fault is detected." base_Class="_epPdYMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_m6jMQMyKEfGts8WNJoPXrQ" base_NamedElement="_m6hXEMyKEfGts8WNJoPXrQ" id="BAT-REQ-13.4" text="The system shall resume mixing only after the mixer has been marked operational again." base_Class="_m6hXEMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_szhx0MyKEfGts8WNJoPXrQ" base_NamedElement="_szc5UMyKEfGts8WNJoPXrQ" id="BAT-REQ-14.1" text="The system shall track the waiting time of every finished batch of batter." base_Class="_szc5UMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_v45AQMyKEfGts8WNJoPXrQ" base_NamedElement="_v40u0MyKEfGts8WNJoPXrQ" id="BAT-REQ-14.2" text="The system shall discard any batter whose waiting time exceeds the maximum batter waiting time (P3)." base_Class="_v40u0MyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_-_WpEMyKEfGts8WNJoPXrQ" base_NamedElement="_-_RJgMyKEfGts8WNJoPXrQ" id="BAT-REQ-14.3" text="The system shall record a discard, with its reason and the batch ID, for every batch discarded because it waited longer than the maximum batter waiting time (P3)." base_Class="_-_RJgMyKEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_Moc8AMyLEfGts8WNJoPXrQ" base_NamedElement="_MoYqkMyLEfGts8WNJoPXrQ" id="BAT-REQ-15.1" text="The system shall hold new batches for as long as depositing is reported stopped." base_Class="_MoYqkMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_UKslcMyLEfGts8WNJoPXrQ" base_NamedElement="_UKqJMMyLEfGts8WNJoPXrQ" id="BAT-REQ-15.2" text="The system shall resume starting new batches once depositing is reported working again." base_Class="_UKqJMMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_dhvNUMyLEfGts8WNJoPXrQ" base_NamedElement="_dhqU0MyLEfGts8WNJoPXrQ" id="BAT-REQ-16" text="The system shall record every log, warning, error and discard event in the slice, each carrying the batch ID, and make it available to Line Monitoring &amp; Health." base_Class="_dhqU0MyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_lTJUIMyLEfGts8WNJoPXrQ" base_NamedElement="_lTFCsMyLEfGts8WNJoPXrQ" id="BAT-REQ-17" text="The system shall make the health state of every function and device in the slice observable at an interval no longer than the health status interval (P4)." base_Class="_lTFCsMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_u7HT8MyLEfGts8WNJoPXrQ" base_NamedElement="_u7DCgMyLEfGts8WNJoPXrQ" id="BAT-NFR-01" text="A fault in this slice shall not affect any batch that has already been handed over to Thermal Processing." base_Class="_u7DCgMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_2lzuwMyLEfGts8WNJoPXrQ" base_NamedElement="_2lwrcMyLEfGts8WNJoPXrQ" id="BAT-NFR-02" text="A single dosing or mixing fault shall cost at most the batch being processed when the fault occurred." base_Class="_2lwrcMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_-Qs94MyLEfGts8WNJoPXrQ" base_NamedElement="_-QoFYMyLEfGts8WNJoPXrQ" id="BAT-NFR-03" text="The system shall continue dosing and mixing from already-reserved ingredients while Production &amp; Logistics Management is not responding." base_Class="_-QoFYMyLEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_Q76f0MyMEfGts8WNJoPXrQ" base_NamedElement="_Q72OYMyMEfGts8WNJoPXrQ" id="BAT-NFR-04" text="A function or device that has stopped responding shall become observable to Line Monitoring &amp; Health within the fault report latency (P5)." base_Class="_Q72OYMyMEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_WjBSQMyMEfGts8WNJoPXrQ" base_NamedElement="_Wi9A0MyMEfGts8WNJoPXrQ" id="BAT-NFR-05" text="Dosing and mixing shall each resume without manual reconfiguration once the fault that stopped them has been cleared." base_Class="_Wi9A0MyMEfGts8WNJoPXrQ"/>
  <Requirements:Requirement xmi:id="_gWhzsMyMEfGts8WNJoPXrQ" base_NamedElement="_gWewYMyMEfGts8WNJoPXrQ" id="BAT-NFR-06" text="Ingredient Intake &amp; Dosing and Mixing Control shall each be deployable without stopping the other." base_Class="_gWewYMyMEfGts8WNJoPXrQ"/>
