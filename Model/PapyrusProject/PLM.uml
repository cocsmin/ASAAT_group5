  <Requirements:Requirement xmi:id="_VvwtgMyFEfG0tpuZPTrJ-Q" base_NamedElement="_VvH0UMyFEfG0tpuZPTrJ-Q" id="PLM-REQ-01" text="The system shall create and schedule production orders for new batter mixing processes" base_Class="_VvH0UMyFEfG0tpuZPTrJ-Q"/>
  <Requirements:Requirement xmi:id="_ETWPEMyHEfG-B8dhrKvttQ" base_NamedElement="_ES-boMyHEfG-B8dhrKvttQ" id="PLM-REQ-02" text="The system shall maintain recipe definitions and target parameters used by production stations" base_Class="_ES-boMyHEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_EyGnoMyHEfG-B8dhrKvttQ" base_NamedElement="_Ex-r0MyHEfG-B8dhrKvttQ" id="PLM-REQ-03" text="The system shall initiate production by sending the &quot;Production order and recipe targets&quot; signal to BAT" base_Class="_Ex-r0MyHEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_FIl1AMyHEfG-B8dhrKvttQ" base_NamedElement="_FIfuYMyHEfG-B8dhrKvttQ" id="PLM-REQ-04" text="The system shall process incoming &quot;Ingredient request and reservation result&quot; signals." base_Class="_FIfuYMyHEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_Grvp0MyHEfG-B8dhrKvttQ" base_NamedElement="_GrrYYMyHEfG-B8dhrKvttQ" id="PLM-REQ-05" text="The system shall verify that requested ingredients are in stock and reserve the required quantities." base_Class="_GrrYYMyHEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_HCvNgMyHEfG-B8dhrKvttQ" base_NamedElement="_HCnRsMyHEfG-B8dhrKvttQ" id="PLM-REQ-06" text="The system shall enforce the business rule that only organic ingredients may be used." base_Class="_HCnRsMyHEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_Fm_LwMyIEfG-B8dhrKvttQ" base_NamedElement="_Fm66UMyIEfG-B8dhrKvttQ" id="PLM-REQ-07" text="The system shall update warehouse inventory numbers when ingredients are collected." base_Class="_Fm66UMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_GhIf0MyIEfG-B8dhrKvttQ" base_NamedElement="_GhBLEMyIEfG-B8dhrKvttQ" id="PLM-REQ-08" text="The system shall return a confirmation signal “Ingredient request and reservation result” for a successful reservation." base_Class="_GhBLEMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_HHMaQMyIEfG-B8dhrKvttQ" base_NamedElement="_HHFskMyIEfG-B8dhrKvttQ" id="PLM-REQ-09" text="The system shall detect when there is insufficient stock to fulfill a reservation request" base_Class="_HHFskMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_WZtiEMyIEfG-B8dhrKvttQ" base_NamedElement="_WZnbcMyIEfG-B8dhrKvttQ" id="PLM-REQ-10" text="The system shall return an insufficient stock &quot;Ingredient request and reservation result&quot; signal when a reservation fails" base_Class="_WZnbcMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_XbUwEMyIEfG-B8dhrKvttQ" base_NamedElement="_XbPQgMyIEfG-B8dhrKvttQ" id="PLM-REQ-11" text="The system shall hold the active production order if an ingredient reservation fails due to insufficient stock." base_Class="_XbPQgMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_YMl08MyIEfG-B8dhrKvttQ" base_NamedElement="_YMg8cMyIEfG-B8dhrKvttQ" id="PLM-REQ-12" text="The system shall publish a &quot;Log, warning, error and discard events&quot; signal to notify Logistics of the missing ingredients." base_Class="_YMg8cMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_nn8vsMyIEfG-B8dhrKvttQ" base_NamedElement="_nn8IoMyIEfG-B8dhrKvttQ" id="PLM-REQ-13" text="The system shall release the held production order only after the required ingredients are restocked and successfully reserved" base_Class="_nn8IoMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_oGY_MMyIEfG-B8dhrKvttQ" base_NamedElement="_oGUGsMyIEfG-B8dhrKvttQ" id="PLM-REQ-14" text="The system shall monitor requests to the Warehouse Management System for timeouts." base_Class="_oGUGsMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_xsCDwMyIEfG-B8dhrKvttQ" base_NamedElement="_xr9yUMyIEfG-B8dhrKvttQ" id="PLM-REQ-15" text="The system shall suspend communication with the warehouse during periods of unresponsiveness and automatically restore communication only once the warehouse is confirmed to be responsive." base_Class="_xr9yUMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_yIQFsMyIEfG-B8dhrKvttQ" base_NamedElement="_yIL0QMyIEfG-B8dhrKvttQ" id="PLM-REQ-16" text="The system shall send an &quot;Ingredient request and reservation result&quot; signal instructing the batching station to continue using already-staged ingredients while warehouse communication is suspended" base_Class="_yIL0QMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_75BcMMyIEfG-B8dhrKvttQ" base_NamedElement="_7478oMyIEfG-B8dhrKvttQ" id="PLM-REQ-17" text="The system shall receive the signal &quot;Pallet ready for shipment&quot; from Finishing &amp; Packaging" base_Class="_7478oMyIEfG-B8dhrKvttQ"/>
  <Requirements:Requirement xmi:id="_8oa40MyIEfG-B8dhrKvttQ" base_NamedElement="_8oX1gMyIEfG-B8dhrKvttQ" id="PLM-REQ-18" text="The system shall assign transport vehicles or slots and coordinate delivery of finished pallets after receiving the ready signal" base_Class="_8oX1gMyIEfG-B8dhrKvttQ"/>
