    <packagedElement xmi:type="uml:StateMachine" xmi:id="_b2iI7-8D01ByumbNQeXFQU" name="SM3 Pallet Lifecycle">
      <ownedComment xmi:type="uml:Comment" xmi:id="_WF5J0RyZ1VyMurVLatHYi2" annotatedElement="_b2iI7-8D01ByumbNQeXFQU">
        <body>Behavior of one pallet in the Palletising IBD: filling (AF-12, FD-11), wrapping (FD-12) and the "Pallet ready for shipment" signal.</body>
      </ownedComment>
      <region xmi:type="uml:Region" xmi:id="_1NBBB_WicaLx2bOPcv4vlI" name="Pallet Lifecycle">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="_95cdnVuIiG43UanHUsLccJ" name="Initial"/>
        <subvertex xmi:type="uml:State" xmi:id="_9KAuYOah0BpUrhS8cfXjGm" name="Filling">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_cX-TysJfcrj9E0gNGRWI_e" name="place cakes on free spots"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_LCkY9HrHHh-K9eci81YNgR" name="register pallet and batch IDs"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_KwqwFh3r2Q1UMKlK28ZPQJ" name="close pallet for further cakes"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_wVGdG0kWwfM6Q_gG9aMEFm" name="Full">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_9tOPtBJg8lu11Zp1JVCI0q" name="wait for pallet wrapper"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_1sxx0kruDFwJE9pUDZ6Sab" name="set pallet aside"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_9p6r7lvglatJcOKsPnIdD1" name="move pallet to pallet wrapper"/>
