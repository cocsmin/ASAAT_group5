    <packagedElement xmi:type="uml:Package" xmi:id="__N4GwM4KEfGJpPDutUy9XQ" name="FIN Requirements">
      <packagedElement xmi:type="uml:Package" xmi:id="_BBTzQM4LEfGJpPDutUy9XQ" name="RD1 Depanning">
      <packagedElement xmi:type="uml:Class" xmi:id="_TKwgEDEaqhzyNnytoB5aoV" name="FIN-REQ-01">
        <ownedComment xmi:type="uml:Comment" xmi:id="_2NZO_uQ-4w2XrQVmBRDtUh" annotatedElement="_TKwgEDEaqhzyNnytoB5aoV">
          <body>Rationale: Entry point of the slice; the batch ID is needed for traceability and recall. Source: UC10, UC11. Feature: FIN-FEAT-01. (Applies to FIN-REQ-01.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_sS8hhss6inCQmw31l26fqX" name="FIN-REQ-02">
        <ownedComment xmi:type="uml:Comment" xmi:id="_NQ1JW8uKwck5HJ28i-vjnp" annotatedElement="_sS8hhss6inCQmw31l26fqX">
          <body>Rationale: The cooling guarantee sits with Thermal Processing at the handoff (UC10 postcondition). Source: UC10. Feature: FIN-FEAT-01. (Applies to FIN-REQ-02.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_AhjVmMyamjXC_9jhUfWa9e" name="FIN-REQ-03">
        <ownedComment xmi:type="uml:Comment" xmi:id="_w0_pRpIddbrPziAYBWLjWK" annotatedElement="_AhjVmMyamjXC_9jhUfWa9e">
          <body>Rationale: Batch traceability for recall; the batch IDs are reported when a pallet is ready. Source: UC10, UC11, UC16. Feature: FIN-FEAT-01. (Applies to FIN-REQ-03.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_EduMVfN7bpdLgfbXJ3c6Rz" name="FIN-REQ-04.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_7qGhIMJnp0EPGme9_7g-D3" annotatedElement="_EduMVfN7bpdLgfbXJ3c6Rz _O_JGOYTTwtt7L5tbe6IDp_ _3st9Fc3VlxZRhOnzbITW6i">
          <body>Rationale: Cake and pan must go their separate ways: the cake to inspection, the pan back into the pan loop. Source: UC11. Feature: FIN-FEAT-01. (Applies to FIN-REQ-04.1, FIN-REQ-04.2, FIN-REQ-04.3.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_O_JGOYTTwtt7L5tbe6IDp_" name="FIN-REQ-04.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_3st9Fc3VlxZRhOnzbITW6i" name="FIN-REQ-04.3">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_syj8zR6gunG0aJdekmrbrc" name="FIN-REQ-26.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_dd1sdP0u3NTVw3T4StZEv6" annotatedElement="_syj8zR6gunG0aJdekmrbrc">
          <body>Rationale: Design decision: these discards are recorded for traceability. Source: FC21, FC26, UC14, UC15. Feature: FIN-FEAT-02. (Applies to FIN-REQ-26.1.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_P9NBqgq9d1gRqAsdewy1qw" name="FIN-REQ-31.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="__AjW2NU9rKZUEOvcZpIuDC" annotatedElement="_P9NBqgq9d1gRqAsdewy1qw _tT9hAYsDpj_CYP2ExeE8el">
          <body>Rationale: Stuck or broken cakes must not enter inspection; the pan must be recovered. Source: FC21. Feature: FIN-FEAT-02. (Applies to FIN-REQ-31.1, FIN-REQ-31.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_tT9hAYsDpj_CYP2ExeE8el" name="FIN-REQ-31.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_K0mWBj1qz1lLToF7KTmotj" name="FIN-REQ-32.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_Ub6F1c2ptm7zT-495srgXN" annotatedElement="_K0mWBj1qz1lLToF7KTmotj _E6qY3Tze_0MpQul9nhk_Me">
          <body>Rationale: Availability: incoming product is neither lost nor discarded during a machine fault. Source: FC22. Feature: FIN-FEAT-03. (Applies to FIN-REQ-32.1, FIN-REQ-32.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_E6qY3Tze_0MpQul9nhk_Me" name="FIN-REQ-32.2">
      </packagedElement>
    </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="_DmyAsM4LEfGJpPDutUy9XQ" name="RD2 Quality Inspection">
      <packagedElement xmi:type="uml:Class" xmi:id="_ctC_zZimA8EsZ2VxXQNggm" name="FIN-REQ-05.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_Y-D0jYMJj-qfZBh75X_SmW" annotatedElement="_ctC_zZimA8EsZ2VxXQNggm _6C8qhKw992UYPhCrCX6iZl">
          <body>Rationale: Only cakes within the regulatory tolerance may pass inspection. Source: UC13. Feature: FIN-FEAT-05. (Applies to FIN-REQ-05.1, FIN-REQ-05.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_6C8qhKw992UYPhCrCX6iZl" name="FIN-REQ-05.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_xlj7fDNuRGwJSfhIENqKTT" name="FIN-REQ-06.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_FjF36M3_2tJdRdFrcUAfkx" annotatedElement="_xlj7fDNuRGwJSfhIENqKTT _iqt2xN5OXzzezpSWT9SqRz">
          <body>Rationale: Only cakes passing visual inspection may proceed to packaging. Source: UC13. Feature: FIN-FEAT-06. (Applies to FIN-REQ-06.1, FIN-REQ-06.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_iqt2xN5OXzzezpSWT9SqRz" name="FIN-REQ-06.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_G9lUp--cLLpQJa3WIeMosr" name="FIN-REQ-07.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="__XQqKueEpymzFdL1gmEYDA" annotatedElement="_G9lUp--cLLpQJa3WIeMosr _smhSJnHLwAXcUnTf6MvPTV">
          <body>Rationale: Product safety; only cakes without metal contamination may proceed to packaging. Source: UC13, FC24. Feature: FIN-FEAT-07. (Applies to FIN-REQ-07.1, FIN-REQ-07.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_smhSJnHLwAXcUnTf6MvPTV" name="FIN-REQ-07.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_gQU9gnSsHUUFRleDJAlNhC" name="FIN-REQ-08.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_uOs4mOvMsFwtee1jxpmopa" annotatedElement="_gQU9gnSsHUUFRleDJAlNhC _YlhQupaD70ahgOQ0TvJDK5">
          <body>Rationale: Only compliant cakes may ship; non-compliant product is separated without stopping the line. Source: UC13, FC24. Feature: FIN-FEAT-08. (Applies to FIN-REQ-08.1, FIN-REQ-08.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_YlhQupaD70ahgOQ0TvJDK5" name="FIN-REQ-08.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_0NvWG9fpauiPCpgf8dNKdz" name="FIN-REQ-09">
        <ownedComment xmi:type="uml:Comment" xmi:id="_MoqjMgF0aeI3bLOx6vMiBg" annotatedElement="_0NvWG9fpauiPCpgf8dNKdz">
          <body>Rationale: Traceability and reporting of quality events for recall. Source: UC13, FC24. Feature: FIN-FEAT-08. (Applies to FIN-REQ-09.)</body>
        </ownedComment>
      </packagedElement>
    </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="_FTRXsM4LEfGJpPDutUy9XQ" name="RD3 Packaging">
      <packagedElement xmi:type="uml:Class" xmi:id="_5agT-OlCIxr89LcspvfiHb" name="FIN-REQ-21.1">
        <ownedComment xmi:type="uml:Comment" xmi:id="_eDuMaKUHT1dJW-6wicHTDQ" annotatedElement="_5agT-OlCIxr89LcspvfiHb _twjH_j3Db0BtCH9sYFsvZc">
          <body>Rationale: Food safety and preservation; only properly wrapped cakes may proceed to shipping. Source: UC14, UC15. Feature: FIN-FEAT-10. (Applies to FIN-REQ-21.1, FIN-REQ-21.2.)</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_twjH_j3Db0BtCH9sYFsvZc" name="FIN-REQ-21.2">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_6Xjc3Gy4OrwdnaWW-iTRnX" name="FIN-REQ-23.1">
