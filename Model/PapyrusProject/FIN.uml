  <Requirements:Requirement xmi:id="_Jrvf9gwuW32y2cX--9CGrB" id="FIN-REQ-01" text="The system shall receive each cake in its pan, together with its batch ID, from Thermal Processing through the signal &quot;Cooled cake&quot;." base_Class="_TKwgEDEaqhzyNnytoB5aoV"/>
  <Requirements:Requirement xmi:id="_ptwP8sYR-UJdsAugStlE_K" id="FIN-REQ-02" text="The system shall accept for depanning only cakes that Thermal Processing has released as having reached the safe internal temperature." base_Class="_sS8hhss6inCQmw31l26fqX"/>
  <Requirements:Requirement xmi:id="_6-fZ2jEo5UbaR92_BHxS49" id="FIN-REQ-03" text="The system shall associate every cake with its batch ID from arrival until the cake is placed on a pallet." base_Class="_AhjVmMyamjXC_9jhUfWa9e"/>
  <Requirements:Requirement xmi:id="_kqR5EXrO1VK1oTUfqzOQGn" id="FIN-REQ-04.1" text="The system shall separate each baked cake from its pan." base_Class="_EduMVfN7bpdLgfbXJ3c6Rz"/>
  <Requirements:Requirement xmi:id="_tAjxO72plX5MnHGqn4G7E9" id="FIN-REQ-04.2" text="The system shall route each depanned cake toward quality inspection." base_Class="_O_JGOYTTwtt7L5tbe6IDp_"/>
  <Requirements:Requirement xmi:id="_BtPsUH_tCJ-Gi72syrcAII" id="FIN-REQ-04.3" text="The system shall route each emptied pan toward the pan washing station." base_Class="_3st9Fc3VlxZRhOnzbITW6i"/>
  <Requirements:Requirement xmi:id="_BxzI3qqDzur6FsSnjfzQ8Q" id="FIN-REQ-26.1" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every cake rejected at depanning." base_Class="_syj8zR6gunG0aJdekmrbrc"/>
  <Requirements:Requirement xmi:id="_q1j4nlCHgh9MG1IApZOWT6" id="FIN-REQ-31.1" text="The system shall reject every cake that has not been removed correctly from its pan." base_Class="_P9NBqgq9d1gRqAsdewy1qw"/>
  <Requirements:Requirement xmi:id="_donapoveodZO1uGh6Yl9r-" id="FIN-REQ-31.2" text="The system shall send the pan of every cake that has not been removed correctly to the washing station." base_Class="_tT9hAYsDpj_CYP2ExeE8el"/>
  <Requirements:Requirement xmi:id="_T1Fo2Rkv-VDKGWrpE1onj_" id="FIN-REQ-32.1" text="The system shall hold cakes arriving at the depanning station while the depanning machine is not responding." base_Class="_K0mWBj1qz1lLToF7KTmotj"/>
  <Requirements:Requirement xmi:id="_alWopq34ihvZVb6pqYl2rU" id="FIN-REQ-32.2" text="The system shall process the held cakes once it has received the signal &quot;Repair confirmed&quot; for the depanning machine." base_Class="_E6qY3Tze_0MpQul9nhk_Me"/>
  <Requirements:Requirement xmi:id="_eTEMFDMLRzwc3rkmAhJGTE" id="FIN-REQ-05.1" text="The system shall weigh every depanned cake." base_Class="_ctC_zZimA8EsZ2VxXQNggm"/>
  <Requirements:Requirement xmi:id="_tzrhjRHSJ4cK0cis1U0_Oj" id="FIN-REQ-05.2" text="The system shall mark a cake as failed if its weight is outside the regulatory tolerance of the target weight." base_Class="_6C8qhKw992UYPhCrCX6iZl"/>
  <Requirements:Requirement xmi:id="_DB3K0NOCSeLkZU4NuPbitN" id="FIN-REQ-06.1" text="The system shall inspect the appearance of every cake." base_Class="_xlj7fDNuRGwJSfhIENqKTT"/>
  <Requirements:Requirement xmi:id="_fi0-ddB5VZZ2UItLQlOjzg" id="FIN-REQ-06.2" text="The system shall mark a cake as failed if its appearance is unsatisfactory." base_Class="_iqt2xN5OXzzezpSWT9SqRz"/>
  <Requirements:Requirement xmi:id="_oWKL-e3eDlOtQ5YCbhuNLk" id="FIN-REQ-07.1" text="The system shall scan every cake for metal contaminants." base_Class="_G9lUp--cLLpQJa3WIeMosr"/>
  <Requirements:Requirement xmi:id="_t_iR-UVckNyAamVdbrkbW-" id="FIN-REQ-07.2" text="The system shall mark a cake as failed if metal is found." base_Class="_smhSJnHLwAXcUnTf6MvPTV"/>
  <Requirements:Requirement xmi:id="_55d1FZ2GnTcOBPE-A3sdIb" id="FIN-REQ-08.1" text="The system shall allow a cake to proceed to packaging only if it has not been marked as failed." base_Class="_gQU9gnSsHUUFRleDJAlNhC"/>
  <Requirements:Requirement xmi:id="_9aIhmbxd_UJp9Kn5XU47T5" id="FIN-REQ-08.2" text="The system shall move every failed cake to the reject bin." base_Class="_YlhQupaD70ahgOQ0TvJDK5"/>
  <Requirements:Requirement xmi:id="_zeOcfMQyJL7TBwK66YrueY" id="FIN-REQ-09" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; (reason, time, batch ID) for every failed cake." base_Class="_0NvWG9fpauiPCpgf8dNKdz"/>
  <Requirements:Requirement xmi:id="__0SIXU-C_qsjHqxxv22f_G" id="FIN-REQ-21.1" text="The system shall wrap every cake that has passed quality inspection." base_Class="_5agT-OlCIxr89LcspvfiHb"/>
  <Requirements:Requirement xmi:id="_zcrrQXY-cVSpbELF-PElJx" id="FIN-REQ-21.2" text="The system shall verify that every wrapped cake is properly wrapped." base_Class="_twjH_j3Db0BtCH9sYFsvZc"/>
  <Requirements:Requirement xmi:id="_WSk769TYzJEZqVGNS1siRx" id="FIN-REQ-23.1" text="The system shall pack every properly wrapped cake in a carton." base_Class="_6Xjc3Gy4OrwdnaWW-iTRnX"/>
  <Requirements:Requirement xmi:id="_B_ntnvp8RjN4Xu3tO1WNcr" id="FIN-REQ-23.2" text="The system shall seal every carton." base_Class="_vaZtm9eaygGWI3r90T2kms"/>
  <Requirements:Requirement xmi:id="_tIZZo0yL4ZVajmGty3Sb2_" id="FIN-REQ-23.3" text="The system shall verify that every cartoned cake is properly cartoned." base_Class="_R95izWTG1E3s9nE_5jG_f3"/>
  <Requirements:Requirement xmi:id="_P6gBZv6b450zZ2RPyI7zdx" id="FIN-REQ-24.1" text="The system shall allow only cakes that are properly wrapped and properly cartoned to proceed to the shipping bin." base_Class="_4X5FPbxph9y5QC8WCHXrJa"/>
  <Requirements:Requirement xmi:id="_TYBwPibr6mxL3YnuX7_abd" id="FIN-REQ-24.2" text="The system shall move every cake that is not properly wrapped or not properly cartoned to the refuse bin." base_Class="_iDNdmTTTX2AZFY2jwikr3q"/>
  <Requirements:Requirement xmi:id="_SMGXT-soK_GIfZXYlAr6VN" id="FIN-REQ-25" text="The system shall check the weight of every sealed case." base_Class="_8zkGJBJzcOwzZt-QD3zq8F"/>
  <Requirements:Requirement xmi:id="_a6td3qTO0t1r6Mmc0bCY82" id="FIN-REQ-26.2" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every cake discarded during packaging." base_Class="_s1_-hQpt6EmcfxgsyREFg8"/>
  <Requirements:Requirement xmi:id="_bohdXzHbvNBjGPEL-natis" id="FIN-REQ-26.3" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every case with an incorrect weight." base_Class="_f35Bvvh8wILzDHwB8Q7xgf"/>
  <Requirements:Requirement xmi:id="_LYQSvWyxTIyzx29ys1GL4r" id="FIN-REQ-33.1" text="The system shall hold incoming cakes in the holding area while the wrapping station is unavailable." base_Class="_T1M_Uwk-x2xDjPQNrFLbH5"/>
  <Requirements:Requirement xmi:id="_W7uJ5XUEwl-A95J90F-S4M" id="FIN-REQ-33.2" text="The system shall wrap the held cakes once it has received the signal &quot;Repair confirmed&quot; for the wrapping station." base_Class="_Ej2ldvLBlVLBHrDMNuq8tE"/>
  <Requirements:Requirement xmi:id="_T3VxztfgEwsWBiVZ_gXzBe" id="FIN-REQ-34" text="The system shall send the signal &quot;Stop / resume pan admission&quot; (stop) to Thermal Processing when the holding area is full." base_Class="_3yebRs-yOItuVrOA7vJURj"/>
  <Requirements:Requirement xmi:id="_dsDOD4i6YRaur8fheWQP3b" id="FIN-REQ-35" text="The system shall send the signal &quot;Stop / resume pan admission&quot; (resume) to Thermal Processing once it has received the signal &quot;Repair confirmed&quot; for the wrapping station." base_Class="_kaEG5AmRaXSYLjjfMo9GNR"/>
  <Requirements:Requirement xmi:id="_gufStC0NwXjH7YCFEcGdph" id="FIN-REQ-27" text="The system shall place every properly cartoned cake on a free spot on the current pallet." base_Class="_NzSgjQE5yxaFOBvk_tOVEr"/>
  <Requirements:Requirement xmi:id="_Ng5Uvt7LnbLI0T3qEss-Qa" id="FIN-REQ-28.1" text="The system shall set a pallet aside for wrapping when all its cake spots are filled." base_Class="_K71hAMvRQzKCgQgHW_0vV1"/>
  <Requirements:Requirement xmi:id="_dFhFdfBHH4yxFx8Vd8gFrV" id="FIN-REQ-28.2" text="The system shall stage a new empty pallet at the packing station when a pallet is set aside." base_Class="_4G59Au3veS5MPm5Tn_kW90"/>
  <Requirements:Requirement xmi:id="_aKkDU3-G-3wZ03ERsYaFSY" id="FIN-REQ-29" text="The system shall wrap every full pallet." base_Class="_AqULhGVOWR0tPVrJzNxtAN"/>
  <Requirements:Requirement xmi:id="_NAA7ufLhT3ScrcQkK8dHFm" id="FIN-REQ-30" text="The system shall publish the signal &quot;Pallet ready for shipment&quot; (pallet ID, cake count, batch IDs) when a wrapped pallet is ready to be moved to shipping storage." base_Class="_z79hB79Wy28QYsIfkZjaD2"/>
  <Requirements:Requirement xmi:id="_soxewQ24e14_OlL9NnPHsI" id="FIN-REQ-11.1" text="The system shall wash every empty pan received at the washing station." base_Class="_VHlw6s5wWOroxjtBhYeNvu"/>
  <Requirements:Requirement xmi:id="_fU3u5sYJxn6DATbetj9Thp" id="FIN-REQ-11.2" text="The system shall dry every washed pan." base_Class="_vglFU9leuBZHYyEBrxKbg2"/>
  <Requirements:Requirement xmi:id="_sDkiCthpSlXoVX3sC_Z0oJ" id="FIN-REQ-11.3" text="The system shall verify that every washed and dried pan is clean and undamaged." base_Class="_Ir6zOKRuhlXHz-6q9rMs_l"/>
  <Requirements:Requirement xmi:id="_ktFlumnXFjJqS2V-5hpJhL" id="FIN-REQ-12.1" text="The system shall queue every pan that passes verification for recirculation to band entry." base_Class="_P9U0OSDRlCCy2XaflpZPEI"/>
  <Requirements:Requirement xmi:id="_plF4duAV6cMgJaj9QZMRA7" id="FIN-REQ-12.2" text="The system shall remove every pan that does not pass verification from the production cycle." base_Class="_kEosNeLJvFZJX_ucvqIDIT"/>
  <Requirements:Requirement xmi:id="_H8xgTSUt2Qqzjn7JZ2yYGD" id="FIN-REQ-13" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every discarded pan." base_Class="_ZFgE0_FbvIY3nXCZY72Co5"/>
  <Requirements:Requirement xmi:id="_hwrwnZalgNKQ2cqK_L40Db" id="FIN-REQ-15" text="The system shall accept pans diverted by Thermal Processing through the signal &quot;Pan for washing&quot;." base_Class="_KBvwNsmJ8VpoAuXnm-sMkb"/>
  <Requirements:Requirement xmi:id="_hTY0KLfdqqZ2CWD7jY87gs" id="FIN-REQ-14" text="The system shall keep the total number of pans in the production system at twice the number needed to fill the full production system." base_Class="_fzjVj-zG5eISJVAG7_rr0x"/>
  <Requirements:Requirement xmi:id="_vk37d8qnHJdfou6fku4jbB" id="FIN-REQ-16" text="The system shall supply a clean pan to the depositing point when it receives the signal &quot;Pan request&quot;." base_Class="_iTANEBhAxQFknjLLlzjkXn"/>
  <Requirements:Requirement xmi:id="_PT9vp_eDOXjDHD7N9eBw0k" id="FIN-REQ-17" text="The system shall report the current clean-pan stock level to Thermal Processing with each &quot;Clean pan supply&quot;." base_Class="_HlNfyeG6hf9qIJ8iDc574W"/>
  <Requirements:Requirement xmi:id="_bfO8mN_3r3dNhe3LZoTUam" id="FIN-REQ-18" text="The system shall continue supplying clean pans from stock while the washing station is unavailable." base_Class="_pIHZcsDH6MkCySFwkeSLX1"/>
  <Requirements:Requirement xmi:id="_y9vSVgrcpUra-8gqqdmQPf" id="FIN-REQ-19" text="The system shall resume washing after a fault only when it has received the signal &quot;Repair confirmed&quot; for the washing station and all conditions for continued washing are met." base_Class="_CEdf-8EELEyxyArrv-_ve0"/>
  <Requirements:Requirement xmi:id="_J-zMQfFWRSuEqnoKhSKaWq" id="FIN-REQ-20.1" text="The system shall wash at an increased speed while pans are waiting after it has received the signal &quot;Repair confirmed&quot; for the washing station." base_Class="_rmYaREz-Gh6qcl-fKelylI"/>
  <Requirements:Requirement xmi:id="_oOONk-_R3fJB1MZ1E89FSZ" id="FIN-REQ-20.2" text="The system shall return to normal washing speed once no backlog remains." base_Class="_tZhljRxha7i50u6Ie0OwsI"/>
  <Requirements:Requirement xmi:id="_5R761SgwC_zrM-ms8MFQo4" id="FIN-REQ-20.3" text="The system shall log every change of washing speed." base_Class="_D5JvFN9sdwUAbwnierFWsA"/>
  <Requirements:Requirement xmi:id="_Bd2LvkoO_fkIYP-2Dpr2SL" id="FIN-REQ-36" text="The system shall make each station controller publish a &quot;Machine status (heartbeat)&quot; at a regular interval." base_Class="_O0VqC4T_ruGjcTgJbhSK0t"/>
  <Requirements:Requirement xmi:id="_6sI0rZhliFbj48NBsZ3KPE" id="FIN-REQ-37.1" text="The system shall continue processing the product already inside its stations when it receives a &quot;Band state change&quot; for a band halt." base_Class="_pK3b0qHaeiDReBxG_O8Y1u"/>
  <Requirements:Requirement xmi:id="_pKAqbDRXBQq91Jw2hYEzN1" id="FIN-REQ-37.2" text="The system shall accept no new product when it receives a &quot;Band state change&quot; for a band halt." base_Class="_4yYVHw79pJJlDROoyF_F2o"/>
  <Requirements:Requirement xmi:id="_4xFf79DRwCTt_QH-IPZ3OU" id="FIN-REQ-38.1" text="The system shall continue processing at the reduced band speed after a &quot;Band state change&quot; for a slow-down." base_Class="_2KBgvCG3QhXJg3Se1QsY2E"/>
  <Requirements:Requirement xmi:id="_amsIHYeVhouwQMeZrEYowX" id="FIN-REQ-38.2" text="The system shall resume normal processing after a &quot;Band state change&quot; for a restart." base_Class="_0GiHr2-yYlYkpHWqTZ1a50"/>
