  <Requirements:Requirement xmi:id="_Jrvf9gwuW32y2cX--9CGrB" base_Class="_TKwgEDEaqhzyNnytoB5aoV" id="FIN-REQ-01" text="The system shall receive each cake in its pan, together with its batch ID, from Thermal Processing through the signal &quot;Cooled cake&quot;."/>
  <Requirements:Requirement xmi:id="_ptwP8sYR-UJdsAugStlE_K" base_Class="_sS8hhss6inCQmw31l26fqX" id="FIN-REQ-02" text="The system shall accept for depanning only cakes that Thermal Processing has released as having reached the safe internal temperature."/>
  <Requirements:Requirement xmi:id="_6-fZ2jEo5UbaR92_BHxS49" base_Class="_AhjVmMyamjXC_9jhUfWa9e" id="FIN-REQ-03" text="The system shall associate every cake with its batch ID from arrival until the cake is placed on a pallet."/>
  <Requirements:Requirement xmi:id="_kqR5EXrO1VK1oTUfqzOQGn" base_Class="_EduMVfN7bpdLgfbXJ3c6Rz" id="FIN-REQ-04.1" text="The system shall separate each baked cake from its pan."/>
  <Requirements:Requirement xmi:id="_tAjxO72plX5MnHGqn4G7E9" base_Class="_O_JGOYTTwtt7L5tbe6IDp_" id="FIN-REQ-04.2" text="The system shall route each depanned cake toward quality inspection."/>
  <Requirements:Requirement xmi:id="_BtPsUH_tCJ-Gi72syrcAII" base_Class="_3st9Fc3VlxZRhOnzbITW6i" id="FIN-REQ-04.3" text="The system shall route each emptied pan toward the pan washing station."/>
  <Requirements:Requirement xmi:id="_BxzI3qqDzur6FsSnjfzQ8Q" base_Class="_syj8zR6gunG0aJdekmrbrc" id="FIN-REQ-26.1" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every cake rejected at depanning."/>
  <Requirements:Requirement xmi:id="_q1j4nlCHgh9MG1IApZOWT6" base_Class="_P9NBqgq9d1gRqAsdewy1qw" id="FIN-REQ-31.1" text="The system shall reject every cake that has not been removed correctly from its pan."/>
  <Requirements:Requirement xmi:id="_donapoveodZO1uGh6Yl9r-" base_Class="_tT9hAYsDpj_CYP2ExeE8el" id="FIN-REQ-31.2" text="The system shall send the pan of every cake that has not been removed correctly to the washing station."/>
  <Requirements:Requirement xmi:id="_T1Fo2Rkv-VDKGWrpE1onj_" base_Class="_K0mWBj1qz1lLToF7KTmotj" id="FIN-REQ-32.1" text="The system shall hold cakes arriving at the depanning station while the depanning machine is not responding."/>
  <Requirements:Requirement xmi:id="_alWopq34ihvZVb6pqYl2rU" base_Class="_E6qY3Tze_0MpQul9nhk_Me" id="FIN-REQ-32.2" text="The system shall process the held cakes once it has received the signal &quot;Repair confirmed&quot; for the depanning machine."/>
  <Requirements:Requirement xmi:id="_eTEMFDMLRzwc3rkmAhJGTE" base_Class="_ctC_zZimA8EsZ2VxXQNggm" id="FIN-REQ-05.1" text="The system shall weigh every depanned cake."/>
  <Requirements:Requirement xmi:id="_tzrhjRHSJ4cK0cis1U0_Oj" base_Class="_6C8qhKw992UYPhCrCX6iZl" id="FIN-REQ-05.2" text="The system shall mark a cake as failed if its weight is outside the regulatory tolerance of the target weight."/>
  <Requirements:Requirement xmi:id="_DB3K0NOCSeLkZU4NuPbitN" base_Class="_xlj7fDNuRGwJSfhIENqKTT" id="FIN-REQ-06.1" text="The system shall inspect the appearance of every cake."/>
  <Requirements:Requirement xmi:id="_fi0-ddB5VZZ2UItLQlOjzg" base_Class="_iqt2xN5OXzzezpSWT9SqRz" id="FIN-REQ-06.2" text="The system shall mark a cake as failed if its appearance is unsatisfactory."/>
  <Requirements:Requirement xmi:id="_oWKL-e3eDlOtQ5YCbhuNLk" base_Class="_G9lUp--cLLpQJa3WIeMosr" id="FIN-REQ-07.1" text="The system shall scan every cake for metal contaminants."/>
  <Requirements:Requirement xmi:id="_t_iR-UVckNyAamVdbrkbW-" base_Class="_smhSJnHLwAXcUnTf6MvPTV" id="FIN-REQ-07.2" text="The system shall mark a cake as failed if metal is found."/>
  <Requirements:Requirement xmi:id="_55d1FZ2GnTcOBPE-A3sdIb" base_Class="_gQU9gnSsHUUFRleDJAlNhC" id="FIN-REQ-08.1" text="The system shall allow a cake to proceed to packaging only if it has not been marked as failed."/>
  <Requirements:Requirement xmi:id="_9aIhmbxd_UJp9Kn5XU47T5" base_Class="_YlhQupaD70ahgOQ0TvJDK5" id="FIN-REQ-08.2" text="The system shall move every failed cake to the reject bin."/>
  <Requirements:Requirement xmi:id="_zeOcfMQyJL7TBwK66YrueY" base_Class="_0NvWG9fpauiPCpgf8dNKdz" id="FIN-REQ-09" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; (reason, time, batch ID) for every failed cake."/>
  <Requirements:Requirement xmi:id="__0SIXU-C_qsjHqxxv22f_G" base_Class="_5agT-OlCIxr89LcspvfiHb" id="FIN-REQ-21.1" text="The system shall wrap every cake that has passed quality inspection."/>
  <Requirements:Requirement xmi:id="_zcrrQXY-cVSpbELF-PElJx" base_Class="_twjH_j3Db0BtCH9sYFsvZc" id="FIN-REQ-21.2" text="The system shall verify that every wrapped cake is properly wrapped."/>
  <Requirements:Requirement xmi:id="_WSk769TYzJEZqVGNS1siRx" base_Class="_6Xjc3Gy4OrwdnaWW-iTRnX" id="FIN-REQ-23.1" text="The system shall pack every properly wrapped cake in a carton."/>
  <Requirements:Requirement xmi:id="_B_ntnvp8RjN4Xu3tO1WNcr" base_Class="_vaZtm9eaygGWI3r90T2kms" id="FIN-REQ-23.2" text="The system shall seal every carton."/>
  <Requirements:Requirement xmi:id="_tIZZo0yL4ZVajmGty3Sb2_" base_Class="_R95izWTG1E3s9nE_5jG_f3" id="FIN-REQ-23.3" text="The system shall verify that every cartoned cake is properly cartoned."/>
  <Requirements:Requirement xmi:id="_P6gBZv6b450zZ2RPyI7zdx" base_Class="_4X5FPbxph9y5QC8WCHXrJa" id="FIN-REQ-24.1" text="The system shall allow only cakes that are properly wrapped and properly cartoned to proceed to the shipping bin."/>
  <Requirements:Requirement xmi:id="_TYBwPibr6mxL3YnuX7_abd" base_Class="_iDNdmTTTX2AZFY2jwikr3q" id="FIN-REQ-24.2" text="The system shall move every cake that is not properly wrapped or not properly cartoned to the refuse bin."/>
  <Requirements:Requirement xmi:id="_SMGXT-soK_GIfZXYlAr6VN" base_Class="_8zkGJBJzcOwzZt-QD3zq8F" id="FIN-REQ-25" text="The system shall check the weight of every sealed case."/>
  <Requirements:Requirement xmi:id="_a6td3qTO0t1r6Mmc0bCY82" base_Class="_s1_-hQpt6EmcfxgsyREFg8" id="FIN-REQ-26.2" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every cake discarded during packaging."/>
  <Requirements:Requirement xmi:id="_bohdXzHbvNBjGPEL-natis" base_Class="_f35Bvvh8wILzDHwB8Q7xgf" id="FIN-REQ-26.3" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every case with an incorrect weight."/>
  <Requirements:Requirement xmi:id="_LYQSvWyxTIyzx29ys1GL4r" base_Class="_T1M_Uwk-x2xDjPQNrFLbH5" id="FIN-REQ-33.1" text="The system shall hold incoming cakes in the holding area while the wrapping station is unavailable."/>
  <Requirements:Requirement xmi:id="_W7uJ5XUEwl-A95J90F-S4M" base_Class="_Ej2ldvLBlVLBHrDMNuq8tE" id="FIN-REQ-33.2" text="The system shall wrap the held cakes once it has received the signal &quot;Repair confirmed&quot; for the wrapping station."/>
  <Requirements:Requirement xmi:id="_T3VxztfgEwsWBiVZ_gXzBe" base_Class="_3yebRs-yOItuVrOA7vJURj" id="FIN-REQ-34" text="The system shall send the signal &quot;Stop / resume pan admission&quot; (stop) to Thermal Processing when the holding area is full."/>
  <Requirements:Requirement xmi:id="_dsDOD4i6YRaur8fheWQP3b" base_Class="_kaEG5AmRaXSYLjjfMo9GNR" id="FIN-REQ-35" text="The system shall send the signal &quot;Stop / resume pan admission&quot; (resume) to Thermal Processing once it has received the signal &quot;Repair confirmed&quot; for the wrapping station."/>
  <Requirements:Requirement xmi:id="_gufStC0NwXjH7YCFEcGdph" base_Class="_NzSgjQE5yxaFOBvk_tOVEr" id="FIN-REQ-27" text="The system shall place every properly cartoned cake on a free spot on the current pallet."/>
  <Requirements:Requirement xmi:id="_Ng5Uvt7LnbLI0T3qEss-Qa" base_Class="_K71hAMvRQzKCgQgHW_0vV1" id="FIN-REQ-28.1" text="The system shall set a pallet aside for wrapping when all its cake spots are filled."/>
  <Requirements:Requirement xmi:id="_dFhFdfBHH4yxFx8Vd8gFrV" base_Class="_4G59Au3veS5MPm5Tn_kW90" id="FIN-REQ-28.2" text="The system shall stage a new empty pallet at the packing station when a pallet is set aside."/>
  <Requirements:Requirement xmi:id="_aKkDU3-G-3wZ03ERsYaFSY" base_Class="_AqULhGVOWR0tPVrJzNxtAN" id="FIN-REQ-29" text="The system shall wrap every full pallet."/>
  <Requirements:Requirement xmi:id="_NAA7ufLhT3ScrcQkK8dHFm" base_Class="_z79hB79Wy28QYsIfkZjaD2" id="FIN-REQ-30" text="The system shall publish the signal &quot;Pallet ready for shipment&quot; (pallet ID, cake count, batch IDs) when a wrapped pallet is ready to be moved to shipping storage."/>
  <Requirements:Requirement xmi:id="_soxewQ24e14_OlL9NnPHsI" base_Class="_VHlw6s5wWOroxjtBhYeNvu" id="FIN-REQ-11.1" text="The system shall wash every empty pan received at the washing station."/>
  <Requirements:Requirement xmi:id="_fU3u5sYJxn6DATbetj9Thp" base_Class="_vglFU9leuBZHYyEBrxKbg2" id="FIN-REQ-11.2" text="The system shall dry every washed pan."/>
  <Requirements:Requirement xmi:id="_sDkiCthpSlXoVX3sC_Z0oJ" base_Class="_Ir6zOKRuhlXHz-6q9rMs_l" id="FIN-REQ-11.3" text="The system shall verify that every washed and dried pan is clean and undamaged."/>
  <Requirements:Requirement xmi:id="_ktFlumnXFjJqS2V-5hpJhL" base_Class="_P9U0OSDRlCCy2XaflpZPEI" id="FIN-REQ-12.1" text="The system shall queue every pan that passes verification for recirculation to band entry."/>
  <Requirements:Requirement xmi:id="_plF4duAV6cMgJaj9QZMRA7" base_Class="_kEosNeLJvFZJX_ucvqIDIT" id="FIN-REQ-12.2" text="The system shall remove every pan that does not pass verification from the production cycle."/>
  <Requirements:Requirement xmi:id="_H8xgTSUt2Qqzjn7JZ2yYGD" base_Class="_ZFgE0_FbvIY3nXCZY72Co5" id="FIN-REQ-13" text="The system shall publish an event on the signal &quot;Log, warning, error and discard events&quot; for every discarded pan."/>
  <Requirements:Requirement xmi:id="_hwrwnZalgNKQ2cqK_L40Db" base_Class="_KBvwNsmJ8VpoAuXnm-sMkb" id="FIN-REQ-15" text="The system shall accept pans diverted by Thermal Processing through the signal &quot;Pan for washing&quot;."/>
  <Requirements:Requirement xmi:id="_hTY0KLfdqqZ2CWD7jY87gs" base_Class="_fzjVj-zG5eISJVAG7_rr0x" id="FIN-REQ-14" text="The system shall keep the total number of pans in the production system at twice the number needed to fill the full production system."/>
  <Requirements:Requirement xmi:id="_vk37d8qnHJdfou6fku4jbB" base_Class="_iTANEBhAxQFknjLLlzjkXn" id="FIN-REQ-16" text="The system shall supply a clean pan to the depositing point when it receives the signal &quot;Pan request&quot;."/>
  <Requirements:Requirement xmi:id="_PT9vp_eDOXjDHD7N9eBw0k" base_Class="_HlNfyeG6hf9qIJ8iDc574W" id="FIN-REQ-17" text="The system shall report the current clean-pan stock level to Thermal Processing with each &quot;Clean pan supply&quot;."/>
  <Requirements:Requirement xmi:id="_bfO8mN_3r3dNhe3LZoTUam" base_Class="_pIHZcsDH6MkCySFwkeSLX1" id="FIN-REQ-18" text="The system shall continue supplying clean pans from stock while the washing station is unavailable."/>
  <Requirements:Requirement xmi:id="_y9vSVgrcpUra-8gqqdmQPf" base_Class="_CEdf-8EELEyxyArrv-_ve0" id="FIN-REQ-19" text="The system shall resume washing after a fault only when it has received the signal &quot;Repair confirmed&quot; for the washing station and all conditions for continued washing are met."/>
  <Requirements:Requirement xmi:id="_J-zMQfFWRSuEqnoKhSKaWq" base_Class="_rmYaREz-Gh6qcl-fKelylI" id="FIN-REQ-20.1" text="The system shall wash at an increased speed while pans are waiting after it has received the signal &quot;Repair confirmed&quot; for the washing station."/>
  <Requirements:Requirement xmi:id="_oOONk-_R3fJB1MZ1E89FSZ" base_Class="_tZhljRxha7i50u6Ie0OwsI" id="FIN-REQ-20.2" text="The system shall return to normal washing speed once no backlog remains."/>
  <Requirements:Requirement xmi:id="_5R761SgwC_zrM-ms8MFQo4" base_Class="_D5JvFN9sdwUAbwnierFWsA" id="FIN-REQ-20.3" text="The system shall log every change of washing speed."/>
  <Requirements:Requirement xmi:id="_Bd2LvkoO_fkIYP-2Dpr2SL" base_Class="_O0VqC4T_ruGjcTgJbhSK0t" id="FIN-REQ-36" text="The system shall make each station controller publish a &quot;Machine status (heartbeat)&quot; at a regular interval."/>
  <Requirements:Requirement xmi:id="_6sI0rZhliFbj48NBsZ3KPE" base_Class="_pK3b0qHaeiDReBxG_O8Y1u" id="FIN-REQ-37.1" text="The system shall continue processing the product already inside its stations when it receives a &quot;Band state change&quot; for a band halt."/>
  <Requirements:Requirement xmi:id="_pKAqbDRXBQq91Jw2hYEzN1" base_Class="_4yYVHw79pJJlDROoyF_F2o" id="FIN-REQ-37.2" text="The system shall accept no new product when it receives a &quot;Band state change&quot; for a band halt."/>
  <Requirements:Requirement xmi:id="_4xFf79DRwCTt_QH-IPZ3OU" base_Class="_2KBgvCG3QhXJg3Se1QsY2E" id="FIN-REQ-38.1" text="The system shall continue processing at the reduced band speed after a &quot;Band state change&quot; for a slow-down."/>
  <Requirements:Requirement xmi:id="_amsIHYeVhouwQMeZrEYowX" base_Class="_0GiHr2-yYlYkpHWqTZ1a50" id="FIN-REQ-38.2" text="The system shall resume normal processing after a &quot;Band state change&quot; for a restart."/>
