        <ownedComment xmi:type="uml:Comment" xmi:id="_-DptAfnphplbhGth8OMuT7">
          <body>Verifies: FIN-REQ-19. Stimulus: After a washing fault, try three cases: repair confirmed but conditions not met, conditions met but no "Repair confirmed", and both. Expected result: Washing resumes only in the third case.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_EjjSx8SAy-9kcXZA0-qk24" name="FIN-TC-42 Verify catch-up speed" clientDependency="_Suz7Y6zfwvfl-3vZhYEUJX">
