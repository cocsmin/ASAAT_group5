    <packagedElement xmi:type="uml:StateMachine" xmi:id="_3YVY1iX8_buiJEFTVaRMTh" name="SM1 Inspection Flow">
      <ownedComment xmi:type="uml:Comment" xmi:id="_Z3LeK7y7dBBm_a4hCG0cUb" annotatedElement="_3YVY1iX8_buiJEFTVaRMTh">
        <body>Behavior of one cake through the Inspection IBD: depanning (AF-01, FD-01), weight, visual and metal checks (AF-03 to AF-05), and the inspection decision with reject handling (AF-06, FD-05).</body>
      </ownedComment>
      <region xmi:type="uml:Region" xmi:id="_WUbKadH-03Krn55UiDkfA6" name="Inspection Flow">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="_csvZftkceRSwgaOPRpdnjb" name="Initial"/>
        <subvertex xmi:type="uml:State" xmi:id="_9-kJ9mYV5vmK-f21FijHoa" name="Awaiting Cake">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_eUUPKYbRaRs-WsWMmnSuZZ" name="wait for Cooled cake"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_cI7yMRvI8s49vjJK4QTjmZ" name="ready depanning station"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_kGCURLnFmf_7WHp8WMIxW7" name="record batch ID of incoming cake"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_o5SZgOzwKrPMqvQAVdzi2E" name="Depanning">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_TtpcyJtNLuHFmtpB6lMSV_" name="separate cake from pan"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_qxKYLGDlDvW1ll8A8Dt6zC" name="start vision-guided pick"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_mAh4-muVOR3RxSSjUNzBc2" name="hand over depanned cake and empty pan"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="__7JVKtTcIjY_uPJgCQSqEv" name="Weighing">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_mDNRVx_bOkFN3mzBXtxEdH" name="compare weight with target and tolerance"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_zxVmZxMqvZiGBbC4v1ZAWK" name="start weight reading"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_vo5Pdp86hWZM_XkbWhNKn-" name="publish Weight result"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_H4aXnmZYwyd0IRwm4jJA27" name="Visual Check">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_MyfRtfxqhkvfRTJiQIPENI" name="inspect appearance of cake"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_RQtGV4euT3M35hAFnjZ7my" name="capture cake image"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_Mi9cgLmu5nA-Um2ibGmJmp" name="publish Visual result"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_c_UKXTE7zoVwPj8esdSazv" name="Holding">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_38ZPDusLiBWWyPLz3cSceQ" name="hold arriving cakes"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_4tvkcj6yCEa_xi1GWvse7T" name="stop picking new cakes"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_LoK7VhGG8w9-D-yjt3dOTu" name="release held cakes for depanning"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_MLKLKEK1g_c4CPtj0Tn1Bh" name="Rejected">
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_xYljEeBzWOTy3MOQ68Xh0B" name="mark cake as rejected and keep reason"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_kPEVp1YoC2jPnmtjMcnIhc" name="Deciding">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_qCW1_jwKj8rfP_NX9aMKdm" name="evaluate failed marks"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="__jMarKEM3NrW7tqiLARaBD" name="collect weight, visual and metal results"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_QeM-SmoSlXrox93SDdCcaL" name="forward decision to packaging or reject bin"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_hkLIzDOSJng61gXmaSkdeo" name="Metal Check">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_Srf_HGeEugpa8nrbc5Bp3g" name="scan cake for metal"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_N5TrUX4tMaZZG69ygkQSZz" name="start metal scan"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_nfch-mGXluIA1mpJnY1eLH" name="publish Metal result"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_4XU1B5-gWqOztSv_jrCaTc" name="Passed">
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_og-OsZRFvUQGJsYQmn5quY" name="hand cake over to packaging"/>
        </subvertex>
        <subvertex xmi:type="uml:FinalState" xmi:id="_xW0BEhnH7QK1fDwEzzXKEe" name="Final"/>
        <transition xmi:type="uml:Transition" xmi:id="_79eiO-06A1w72kIi7eXpKb" name="T0" source="_csvZftkceRSwgaOPRpdnjb" target="_9-kJ9mYV5vmK-f21FijHoa">
