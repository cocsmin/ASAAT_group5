    <packagedElement xmi:type="uml:StateMachine" xmi:id="_4isO4X77TnSitWdvBEDMF3" name="SM5 Band Response and Health">
      <ownedComment xmi:type="uml:Comment" xmi:id="_Z98Kl0oBlzy-LJu20UQCLX" annotatedElement="_4isO4X77TnSitWdvBEDMF3">
        <body>Behavior of the Reporting IBD: how Band-State Response (AF-17) reacts to band state changes, in parallel with periodic Health Reporting (AF-16). Event Reporting (AF-18) has no states of its own and appears as the "publish event" effects in SM1 to SM4.</body>
      </ownedComment>
      <region xmi:type="uml:Region" xmi:id="_bG03-O9i-AMtYdON4eySaV" name="Band Response">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="_3E0VQTV9I1u_kAoC6jLj6l" name="Initial"/>
        <subvertex xmi:type="uml:State" xmi:id="_rROcJrkOfaqkDhg1G3j1b0" name="Running">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_v8flxvgZ0HEUrdAwCUjIlS" name="process incoming product"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_UbutcpBFbURAGJFCEgzoST" name="set band speed to normal"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_OswKdoZ0mwR0URRXke9Llt" name="note band state change"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_layNdLyNf4OalZT2GZj_X9" name="Slowed">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_f9GZoNe-YZyLA29tpbnpIX" name="process product at reduced speed"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_Ero5sCuXHD-KUnDR_-rnDV" name="set reduced band speed"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_ZV2el6L63_my2Dx2TC1ty1" name="note band state change"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_HMAgdhkA_S5Yc1xg5Iow3E" name="Halted">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_WkF973SMRl-mljz2mAI5NA" name="finish product already inside stations"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="_mt5BuZdj4XO65Ozgd5OE_9" name="stop accepting new product"/>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_4fiSnmIwGbBPTyeFjBj69p" name="re-enable product intake"/>
        </subvertex>
        <transition xmi:type="uml:Transition" xmi:id="_RpAyeQ81njA38RRCKHUejW" name="T0" source="_3E0VQTV9I1u_kAoC6jLj6l" target="_rROcJrkOfaqkDhg1G3j1b0">
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="_lo5q6VwbOutkR6H7TEO0IT" name="T1" source="_rROcJrkOfaqkDhg1G3j1b0" target="_layNdLyNf4OalZT2GZj_X9">
