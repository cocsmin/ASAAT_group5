      <packagedElement xmi:type="uml:Abstraction" xmi:id="_Lz8ZHhRCkURc6bDpV_HXW6" client="__aqruToswr5-5-6q2LrJ5N" supplier="_fzjVj-zG5eISJVAG7_rr0x"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_0-g6CBp_25oDvlQq57ll9Z" client="_fzuBYD8FkQxLag2v0CQ_NP" supplier="_iTANEBhAxQFknjLLlzjkXn"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_JSVEm4PD0opr05YQNlixp5" client="_wQTS5-JKptuQd-2N6HOnUY" supplier="_HlNfyeG6hf9qIJ8iDc574W"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_4sb1zkxQ4eVoPXvVv799In" client="_2ZKYfydNZYYEYI--orkeHV" supplier="_pIHZcsDH6MkCySFwkeSLX1"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_TuKVZrbLYAVnxFL78HHjG2" client="_-DMQidQdbLrxgOjBOqSm7S" supplier="_CEdf-8EELEyxyArrv-_ve0"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_Suz7Y6zfwvfl-3vZhYEUJX" client="_EjjSx8SAy-9kcXZA0-qk24" supplier="_rmYaREz-Gh6qcl-fKelylI"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_ef-eLgWi0bGmpCKXXXuRAw" client="_hb0e9RoR7lcWiICuf-nEl7" supplier="_tZhljRxha7i50u6Ie0OwsI"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_AML2wXt7nABgHlGe1l9fYO" client="_U7NJqFsq_GLpNV8GhcjCC9" supplier="_D5JvFN9sdwUAbwnierFWsA"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_NXoREoXODr47M2BCy8Clxw" client="_xIMMQclUo26BJE9OrOTHNN" supplier="_O0VqC4T_ruGjcTgJbhSK0t"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_RpJRW-SYTefQLHV1VqUmHm" client="_U3u-tN2YkudZMmQHkZdGu1" supplier="_pK3b0qHaeiDReBxG_O8Y1u"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_QfEapVgoPKiWlTyoq4tOZv" client="_U3u-tN2YkudZMmQHkZdGu1" supplier="_4yYVHw79pJJlDROoyF_F2o"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="_6cVaQd8U9qZfIV-AFVx67M" client="_-HaDqWLRXoR1U7Nu_jS0kb" supplier="_2KBgvCG3QhXJg3Se1QsY2E"/>
      <packagedElement xmi:type="uml:Abstraction" xmi:id="__Wcs_lTfC7RL1DiF7UhQp2" client="_YeIkd4F1eia3J5757fNUcS" supplier="_0GiHr2-yYlYkpHWqTZ1a50"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="_8l1LATdqvgxi1J728O1kdy" name="FIN Verification">
      <packagedElement xmi:type="uml:Activity" xmi:id="_Sccr-TnvBC18Jw0LkggBMY" name="FIN-TC-01 Verify cooled cake intake">
        <ownedComment xmi:type="uml:Comment" xmi:id="_p93HWb7-zVZqqLjafAubac">
          <body>Verifies: FIN-REQ-01. Stimulus: Send &quot;Cooled cake&quot; with batch ID B1, marked as released by Thermal Processing. Expected result: The cake is received in its pan with B1 attached.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_9NRG3P9JsPRZ6s1uVkEH-B" name="FIN-TC-02 Verify rejection of unreleased cake">
        <ownedComment xmi:type="uml:Comment" xmi:id="_YDeTGVNVe96VLExzyqHsgo">
          <body>Verifies: FIN-REQ-02. Stimulus: Present a cake that Thermal Processing has not released as safe-temperature. Expected result: The cake is not accepted for depanning.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_8bGGcyC_bBqy3BvHB6LRha" name="FIN-TC-03 Verify depanning and routing">
        <ownedComment xmi:type="uml:Comment" xmi:id="_tprhhGtfMPnu_K5sL2uSBl">
          <body>Verifies: FIN-REQ-04.1, FIN-REQ-04.2, FIN-REQ-04.3. Stimulus: Depan a cake that comes out cleanly. Expected result: The cake is separated from its pan. The cake is routed toward Weight Check, and the empty pan toward washing.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_7H1h-2zl3VVsVCjYC2HNvP" name="FIN-TC-04 Verify batch ID traceability">
        <ownedComment xmi:type="uml:Comment" xmi:id="_nS6sBTYdkMrm5_AVphlVj-">
          <body>Verifies: FIN-REQ-03. Stimulus: Follow B1 from arrival to the &quot;Pallet ready for shipment&quot; signal. Expected result: B1 is associated with the cake at every stage and appears in the pallet's batch IDs.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_aARvCAEJgyi9_mHVpHbk9g" name="FIN-TC-05 Verify stuck-cake rejection">
        <ownedComment xmi:type="uml:Comment" xmi:id="_8ir8B00SEz2RTEQoqSnO78">
          <body>Verifies: FIN-REQ-31.1, FIN-REQ-31.2, FIN-REQ-26.1. Stimulus: Simulate a stuck or broken cake at depanning (FC21). Expected result: The cake is rejected and never reaches inspection. Its pan is sent to washing. An event with reason, time and batch ID is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_SDL6FomD2VHFIw1j6HcQgY" name="FIN-TC-06 Verify hold on depanning fault">
        <ownedComment xmi:type="uml:Comment" xmi:id="_nAl65x4ZEvVZkJAuXCafX0">
          <body>Verifies: FIN-REQ-32.1. Stimulus: Stop the depanning machine's response and send cakes to the depanning station (FC22). Expected result: The cakes are held. None are lost or discarded.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_w1TiGbBUQnDqCE9KuOsvYU" name="FIN-TC-07 Verify processing after depanning repair">
        <ownedComment xmi:type="uml:Comment" xmi:id="_Mw7RSjGk-_SDYiPkHfzDg4">
          <body>Verifies: FIN-REQ-32.2. Stimulus: Following FIN-TC-06, send &quot;Repair confirmed&quot; for the depanning machine. Expected result: The held cakes are processed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_vs2IKoTx1NtW9BrJ6nJgRB" name="FIN-TC-08 Verify weighing within tolerance">
        <ownedComment xmi:type="uml:Comment" xmi:id="_fz9GF8Dlxp_JMNYRC9ujri">
          <body>Verifies: FIN-REQ-05.1. Stimulus: Send a cake at target weight to the weigh station. Expected result: The cake is weighed and the result is pass.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_b2DPrqBcBmupy2Sxl5BaNB" name="FIN-TC-09 Verify weight outside tolerance">
        <ownedComment xmi:type="uml:Comment" xmi:id="_sJxTSZZ-z_1Lisbi28wWem">
          <body>Verifies: FIN-REQ-05.2. Stimulus: Send one cake just below and one just above the tolerance limits. Expected result: Both are marked failed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_J1F-z4YC8BNgsj-7DqEfyc" name="FIN-TC-10 Verify visual pass">
        <ownedComment xmi:type="uml:Comment" xmi:id="_tdHljVNgY8CYVebglRGB0G">
          <body>Verifies: FIN-REQ-06.1. Stimulus: Send a cake with acceptable appearance. Expected result: Its appearance is inspected and the result is pass.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_iiHy8uPAEtqBiue-qdEpTu" name="FIN-TC-11 Verify visual failure">
        <ownedComment xmi:type="uml:Comment" xmi:id="_6_Qrq3YFIOK4memluVTako">
          <body>Verifies: FIN-REQ-06.2. Stimulus: Send a cake with an unsatisfactory appearance. Expected result: The cake is marked failed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_tXJVo89Rz3tT8eyq5Am_As" name="FIN-TC-12 Verify clean metal scan">
        <ownedComment xmi:type="uml:Comment" xmi:id="_d3iBOx4XulKaLAX-Ymxjdb">
          <body>Verifies: FIN-REQ-07.1. Stimulus: Send a clean cake through the metal scan. Expected result: The cake is scanned and the result is pass.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_TSzb02-xS9TPD3684rzGCa" name="FIN-TC-13 Verify metal detection">
        <ownedComment xmi:type="uml:Comment" xmi:id="_oJU2O0YyJjlQ8Peh4OQf5_">
          <body>Verifies: FIN-REQ-07.2. Stimulus: Send a cake containing a metal contaminant (FC24). Expected result: The cake is marked failed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_YXFX2dATH51F2z-3_4p_nR" name="FIN-TC-14 Verify compliant cake proceeds">
        <ownedComment xmi:type="uml:Comment" xmi:id="_clsZ_X9OP75ZeypPWbmBse">
          <body>Verifies: FIN-REQ-08.1. Stimulus: Send a cake that passes weight, visual and metal checks. Expected result: The cake proceeds to packaging.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_6L0S37RljoAXBPGDt7Gc0R" name="FIN-TC-15 Verify rejection of failed cakes">
        <ownedComment xmi:type="uml:Comment" xmi:id="_8d1chGbjrRiCN_YJm6JaYG">
          <body>Verifies: FIN-REQ-08.1, FIN-REQ-08.2. Stimulus: Run three cakes, each failing exactly one check (weight, visual, metal). Expected result: Each goes to the reject bin and none proceeds to packaging. The line keeps running.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_cWdK1BYipoMRIVdcqa_KNZ" name="FIN-TC-16 Verify failed-cake event">
        <ownedComment xmi:type="uml:Comment" xmi:id="_8JdhGTaKgeyp4envgGSBJJ">
          <body>Verifies: FIN-REQ-09. Stimulus: Fail a cake at any inspection check. Expected result: An event with reason, time and batch ID is published for that cake.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_3pJ74tmd7IA1rNOE6bb_Bv" name="FIN-TC-17 Verify wrapping">
        <ownedComment xmi:type="uml:Comment" xmi:id="_-bv4yWL9dw2hV2Fb_5PIF9">
          <body>Verifies: FIN-REQ-21.1. Stimulus: Send an inspected cake to the wrapping station. Expected result: The cake is wrapped.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_cGlPrCUYmEoa_edLQZCkur" name="FIN-TC-18 Verify wrap verification">
        <ownedComment xmi:type="uml:Comment" xmi:id="_JbAozrt15xWDpJkl14zJkC">
          <body>Verifies: FIN-REQ-21.2. Stimulus: Wrap one cake correctly and one with a wrapping defect. Expected result: The correct wrap passes verification. The defective wrap is detected.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_PY6miTbofQ23cWd-PrFJGM" name="FIN-TC-19 Verify cartoning and sealing">
        <ownedComment xmi:type="uml:Comment" xmi:id="_tCl9miiljEiH2uSseC_kpK">
          <body>Verifies: FIN-REQ-23.1, FIN-REQ-23.2. Stimulus: Send a properly wrapped cake to the cartoning station. Expected result: The cake is packed in a carton and the carton is sealed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_nZju8I2ivXi_AK3ckIS6K5" name="FIN-TC-20 Verify carton verification">
        <ownedComment xmi:type="uml:Comment" xmi:id="_ryAzFUkENDQHmdQLwzMCLD">
          <body>Verifies: FIN-REQ-23.3. Stimulus: Carton one cake correctly and one with a cartoning defect. Expected result: The correct carton passes verification. The defective one is detected.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_2hemGT3Lbi99d_EEtQcl68" name="FIN-TC-21 Verify shipping of proper cakes">
        <ownedComment xmi:type="uml:Comment" xmi:id="_VgSdu03oT_3tmeWdMBVEal">
          <body>Verifies: FIN-REQ-24.1. Stimulus: Send a cake that is both properly wrapped and properly cartoned. Expected result: The cake proceeds to the shipping bin.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_i78om9I80XU4OEjmkoEl68" name="FIN-TC-22 Verify refuse of improper cakes">
        <ownedComment xmi:type="uml:Comment" xmi:id="_K98_GpPzRix6Zr8v4JOfkx">
          <body>Verifies: FIN-REQ-24.2, FIN-REQ-26.2. Stimulus: Send one cake that is improperly wrapped and one that is improperly cartoned. Expected result: Both go to the refuse bin. An event is published for each.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_caX3Cs3BrSCgQj32RqrM6J" name="FIN-TC-23 Verify correct case weight">
        <ownedComment xmi:type="uml:Comment" xmi:id="_r6_J4zgkyXz_HDsPMsjFfR">
          <body>Verifies: FIN-REQ-25. Stimulus: Send a sealed case of correct weight to the case weight check. Expected result: The weight is checked and no event is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_maNvFDX-jl72XW9xBk259Z" name="FIN-TC-24 Verify incorrect case weight">
        <ownedComment xmi:type="uml:Comment" xmi:id="_dq8M8lR-MCySE-b1X3Uvff">
          <body>Verifies: FIN-REQ-25, FIN-REQ-26.3. Stimulus: Send a sealed case of incorrect weight (FC26). Expected result: The incorrect weight is detected and an event is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_cLteRSCztC8rmDVKIZij4r" name="FIN-TC-25 Verify holding on wrapping fault">
        <ownedComment xmi:type="uml:Comment" xmi:id="_tk-OoWXdsGZZaRz4kkfwZa">
          <body>Verifies: FIN-REQ-33.1. Stimulus: Make the wrapping station unavailable (FC25) and send cakes forward. Expected result: The cakes are held in the holding area.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_lQBHWO5g0DpZmE2Lwbvfge" name="FIN-TC-26 Verify pan admission stop">
        <ownedComment xmi:type="uml:Comment" xmi:id="_dkWCxag6mghDS1lm-RxIeu">
          <body>Verifies: FIN-REQ-34. Stimulus: Keep sending cakes until the holding area is full. Expected result: &quot;Stop / resume pan admission&quot; (stop) is sent to Thermal Processing.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_7eCxJlMrbcS6q6MAkZ-BxW" name="FIN-TC-27 Verify wrapping after repair and resume">
        <ownedComment xmi:type="uml:Comment" xmi:id="_aSA2eUzDAQ70F4Sl8tsx2q">
          <body>Verifies: FIN-REQ-33.2, FIN-REQ-35. Stimulus: Following FIN-TC-26, send &quot;Repair confirmed&quot; for the wrapping station. Expected result: The held cakes are wrapped, and &quot;Stop / resume pan admission&quot; (resume) is sent.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_wqB6eE2iyHql1jlIWJUoIL" name="FIN-TC-28 Verify placing on pallet">
        <ownedComment xmi:type="uml:Comment" xmi:id="_IKJb95Am_YCknym8gI1Sxa">
          <body>Verifies: FIN-REQ-27. Stimulus: Send a properly cartoned cake to the packing station. Expected result: The cake is placed on a free spot on the current pallet.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_IjKQEFl8Eb-Zo2HPjUw8h_" name="FIN-TC-29 Verify full-pallet handling">
        <ownedComment xmi:type="uml:Comment" xmi:id="_eGYt-_KyNYNyYR0uDhbWAt">
          <body>Verifies: FIN-REQ-28.1, FIN-REQ-28.2. Stimulus: Fill the last free spot on a pallet. Expected result: The full pallet is set aside for wrapping. A new empty pallet is staged, and palletising continues without waiting.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_wdmce0Ol-ivwYKIBddSgrW" name="FIN-TC-30 Verify pallet wrapping">
        <ownedComment xmi:type="uml:Comment" xmi:id="_2_oRSZxu2896DJVT5KG_pD">
          <body>Verifies: FIN-REQ-29. Stimulus: Set aside a full pallet. Expected result: The pallet is wrapped.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_bjVb4p0LPnjswqUQmp527Q" name="FIN-TC-31 Verify pallet ready signal">
        <ownedComment xmi:type="uml:Comment" xmi:id="_ja_bKeX9XFFHLKeSn0CTX0">
          <body>Verifies: FIN-REQ-30. Stimulus: Complete the wrapping of a pallet. Expected result: &quot;Pallet ready for shipment&quot; is published with pallet ID, cake count and batch IDs.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_QA-epNGnZkBM2mB0KtMvHH" name="FIN-TC-32 Verify washing, drying and verification">
        <ownedComment xmi:type="uml:Comment" xmi:id="_Vu9NayUPwm1HH29kzxc6I8">
          <body>Verifies: FIN-REQ-11.1, FIN-REQ-11.2, FIN-REQ-11.3. Stimulus: Send an empty pan to the washing station. Expected result: The pan is washed and dried, then verified as clean and undamaged.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_IPcftC3ghaKUeClLFKMJWx" name="FIN-TC-33 Verify recirculation of clean pans">
        <ownedComment xmi:type="uml:Comment" xmi:id="_LYyBFzLWH-YFnRBziWaU7s">
          <body>Verifies: FIN-REQ-12.1. Stimulus: Send a pan that passes verification. Expected result: The pan is queued for recirculation to band entry.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_t9LJt97jnYSyAKQSjyiY90" name="FIN-TC-34 Verify discard of unclean pan">
        <ownedComment xmi:type="uml:Comment" xmi:id="_ftm70b9c3DsxVpjYm0JkJo">
          <body>Verifies: FIN-REQ-12.2, FIN-REQ-13. Stimulus: Send a pan that is not properly washed. Expected result: The pan is removed from the production cycle. A discard event is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_ZPcWWLQOiCVxQVGiSGC-tq" name="FIN-TC-35 Verify discard of damaged pan">
        <ownedComment xmi:type="uml:Comment" xmi:id="_FDvwmvSnjTQjYh9fwlHKtg">
          <body>Verifies: FIN-REQ-12.2, FIN-REQ-13. Stimulus: Send a pan that is damaged after washing. Expected result: The pan is removed from the production cycle. A discard event is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_TD8fZ8GJSL1wkshMSS6Chc" name="FIN-TC-36 Verify diverted pan acceptance">
        <ownedComment xmi:type="uml:Comment" xmi:id="_MM0XopuOBDcT8SR5ZpcqbO">
          <body>Verifies: FIN-REQ-15. Stimulus: Send &quot;Pan for washing&quot; from Thermal Processing for a pan diverted after a wrong fill weight. Expected result: The pan is accepted and washed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="__aqruToswr5-5-6q2LrJ5N" name="FIN-TC-37 Verify pan stock rule">
        <ownedComment xmi:type="uml:Comment" xmi:id="_gHf1gpHtdyxrwJ8lCB6l8b">
          <body>Verifies: FIN-REQ-14. Stimulus: Check the total pan count at start, then after one pan is discarded. Expected result: The total stays at twice the number needed to fill the production system.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_fzuBYD8FkQxLag2v0CQ_NP" name="FIN-TC-38 Verify clean pan supply">
        <ownedComment xmi:type="uml:Comment" xmi:id="_Cjt_fRBrJyJ9eoUgcZQnde">
          <body>Verifies: FIN-REQ-16. Stimulus: Send &quot;Pan request&quot; when no pan is at depositing (FC8). Expected result: A clean pan is supplied to the depositing point.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_wQTS5-JKptuQd-2N6HOnUY" name="FIN-TC-39 Verify stock level report">
        <ownedComment xmi:type="uml:Comment" xmi:id="_UE0EYKDUxPkYIgMDW52xuz">
          <body>Verifies: FIN-REQ-17. Stimulus: Send &quot;Pan request&quot; at two different stock levels. Expected result: Each &quot;Clean pan supply&quot; carries the current stock level.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_2ZKYfydNZYYEYI--orkeHV" name="FIN-TC-40 Verify supply during washing outage">
        <ownedComment xmi:type="uml:Comment" xmi:id="_2CxW2kWODtcnnRMZxIuB8a">
          <body>Verifies: FIN-REQ-18. Stimulus: Make the washing station unavailable (FC23) and send &quot;Pan request&quot;. Expected result: Clean pans are still supplied from stock.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_-DMQidQdbLrxgOjBOqSm7S" name="FIN-TC-41 Verify washing resume conditions">
        <ownedComment xmi:type="uml:Comment" xmi:id="_-DptAfnphplbhGth8OMuT7">
          <body>Verifies: FIN-REQ-19. Stimulus: After a washing fault, try three cases: repair confirmed but conditions not met, conditions met but no &quot;Repair confirmed&quot;, and both. Expected result: Washing resumes only in the third case.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_EjjSx8SAy-9kcXZA0-qk24" name="FIN-TC-42 Verify catch-up speed">
        <ownedComment xmi:type="uml:Comment" xmi:id="_NNBOWmu8Q-hbCNh7Ut300A">
          <body>Verifies: FIN-REQ-20.1. Stimulus: Confirm repair while a pan backlog exists. Expected result: Washing runs at increased speed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_hb0e9RoR7lcWiICuf-nEl7" name="FIN-TC-43 Verify return to normal speed">
        <ownedComment xmi:type="uml:Comment" xmi:id="_-xERqcAP6Do-mnO8wPFmlO">
          <body>Verifies: FIN-REQ-20.2. Stimulus: Following FIN-TC-42, let the backlog drop to zero. Expected result: Washing returns to normal speed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_U7NJqFsq_GLpNV8GhcjCC9" name="FIN-TC-44 Verify speed-change logging">
        <ownedComment xmi:type="uml:Comment" xmi:id="_L8rNk0ENm6m-VdLfLr4YS3">
          <body>Verifies: FIN-REQ-20.3. Stimulus: Run FIN-TC-42 and FIN-TC-43. Expected result: Each change of washing speed is logged.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_xIMMQclUo26BJE9OrOTHNN" name="FIN-TC-45 Verify heartbeat">
        <ownedComment xmi:type="uml:Comment" xmi:id="_QtLkK_VR-9eU_eHYK_vOHs">
          <body>Verifies: FIN-REQ-36. Stimulus: Observe every station controller over several heartbeat intervals, then stop one controller. Expected result: Each controller publishes &quot;Machine status (heartbeat)&quot; at the configured interval. The stopped one's missing heartbeat is detectable.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_U3u-tN2YkudZMmQHkZdGu1" name="FIN-TC-46 Verify band halt">
        <ownedComment xmi:type="uml:Comment" xmi:id="_c4wnSoVPRvoQ2DQQGy7h_C">
          <body>Verifies: FIN-REQ-37.1, FIN-REQ-37.2. Stimulus: Send &quot;Band state change&quot; (halt) while product is inside the stations. Expected result: The product already inside is processed. No new product is accepted.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_-HaDqWLRXoR1U7Nu_jS0kb" name="FIN-TC-47 Verify band slow-down">
        <ownedComment xmi:type="uml:Comment" xmi:id="_4UHjA_hqdDqAz_F3RG-YKj">
          <body>Verifies: FIN-REQ-38.1. Stimulus: Send &quot;Band state change&quot; (slow-down). Expected result: Processing continues at the reduced band speed.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_YeIkd4F1eia3J5757fNUcS" name="FIN-TC-48 Verify band restart">
        <ownedComment xmi:type="uml:Comment" xmi:id="_MelagN_IW58ZcjPaKzLamG">
          <body>Verifies: FIN-REQ-38.2. Stimulus: Following FIN-TC-46 or FIN-TC-47, send &quot;Band state change&quot; (restart). Expected result: Normal processing resumes.</body>
        </ownedComment>
      </packagedElement>
    </packagedElement>
