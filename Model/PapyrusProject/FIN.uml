    <packagedElement xmi:type="uml:Package" xmi:id="_8l1LATdqvgxi1J728O1kdy" name="FIN Verification">
      <packagedElement xmi:type="uml:Activity" xmi:id="_Sccr-TnvBC18Jw0LkggBMY" name="FIN-TC-01 Verify cooled cake intake" clientDependency="_z46VtAZdSNOvcR1FF3EUZK">
        <ownedComment xmi:type="uml:Comment" xmi:id="_p93HWb7-zVZqqLjafAubac">
          <body>Verifies: FIN-REQ-01. Stimulus: Send "Cooled cake" with batch ID B1, marked as released by Thermal Processing. Expected result: The cake is received in its pan with B1 attached.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_9NRG3P9JsPRZ6s1uVkEH-B" name="FIN-TC-02 Verify rejection of unreleased cake" clientDependency="_ye68al9znm7rWjY8A-ZYS5">
        <ownedComment xmi:type="uml:Comment" xmi:id="_YDeTGVNVe96VLExzyqHsgo">
          <body>Verifies: FIN-REQ-02. Stimulus: Present a cake that Thermal Processing has not released as safe-temperature. Expected result: The cake is not accepted for depanning.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_8bGGcyC_bBqy3BvHB6LRha" name="FIN-TC-03 Verify depanning and routing" clientDependency="_q-2-5I0vv7YkwGdRjWJ9fL _nLTcPrOKT1zOY7JIoeOO0N _EtmjHZhAwn_ap5dVVLa9Fl">
        <ownedComment xmi:type="uml:Comment" xmi:id="_tprhhGtfMPnu_K5sL2uSBl">
          <body>Verifies: FIN-REQ-04.1, FIN-REQ-04.2, FIN-REQ-04.3. Stimulus: Depan a cake that comes out cleanly. Expected result: The cake is separated from its pan. The cake is routed toward Weight Check, and the empty pan toward washing.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_7H1h-2zl3VVsVCjYC2HNvP" name="FIN-TC-04 Verify batch ID traceability" clientDependency="_kcF5GKNnuikREb2GBcvPbe">
        <ownedComment xmi:type="uml:Comment" xmi:id="_nS6sBTYdkMrm5_AVphlVj-">
          <body>Verifies: FIN-REQ-03. Stimulus: Follow B1 from arrival to the "Pallet ready for shipment" signal. Expected result: B1 is associated with the cake at every stage and appears in the pallet's batch IDs.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_aARvCAEJgyi9_mHVpHbk9g" name="FIN-TC-05 Verify stuck-cake rejection" clientDependency="_gNGQC7PeHuHLDdjoS2-qlU _sT_8FaxDXBgwRrV_DB_SH- _3P1I3_NGYxh7KtkTKCzD-Y">
        <ownedComment xmi:type="uml:Comment" xmi:id="_8ir8B00SEz2RTEQoqSnO78">
          <body>Verifies: FIN-REQ-31.1, FIN-REQ-31.2, FIN-REQ-26.1. Stimulus: Simulate a stuck or broken cake at depanning (FC21). Expected result: The cake is rejected and never reaches inspection. Its pan is sent to washing. An event with reason, time and batch ID is published.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="_SDL6FomD2VHFIw1j6HcQgY" name="FIN-TC-06 Verify hold on depanning fault" clientDependency="_1dFMre-safIbNflO8I_n4d">
        <ownedComment xmi:type="uml:Comment" xmi:id="_nAl65x4ZEvVZkJAuXCafX0">
          <body>Verifies: FIN-REQ-32.1. Stimulus: Stop the depanning machine's response and send cakes to the depanning station (FC22). Expected result: The cakes are held. None are lost or discarded.</body>
        </ownedComment>
      </packagedElement>
