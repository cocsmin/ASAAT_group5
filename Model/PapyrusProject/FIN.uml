          <exit xmi:type="uml:OpaqueBehavior" xmi:id="_bIgm4q8MjxcG9ureAMsmjl" name="stop pallet wrapper"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="_9d5fPagDPxRnNvrApdMTXm" name="Ready">
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_FuywTePwjY23iEeiujkR3j" name="wait for move to shipping storage"/>
