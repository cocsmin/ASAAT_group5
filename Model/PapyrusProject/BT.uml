  <Requirements:Requirement xmi:id="_Nle40NIZEfGKVdaTCg46lw" base_NamedElement="_NlYLINIZEfGKVdaTCg46lw" id="BT-REQ-00" text="The Band Transport subsystem shall provide controlled and reliable conveyor operation, including section control, speed monitoring, fault detection and handling, and supervision of transport equipment to support the cake production process." base_Class="_NlYLINIZEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="__0Nr4NIZEfGKVdaTCg46lw" base_NamedElement="__0KBgNIZEfGKVdaTCg46lw" id="BT-REQ-01" text="The Band Transport subsystem shall control individual conveyor sections, including starting, stopping, and coordinating their operation to ensure controlled movement of products along the production line." base_Class="__0KBgNIZEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_QRqVwNIaEfGKVdaTCg46lw" base_NamedElement="_QRnScNIaEfGKVdaTCg46lw" id="BT-REQ-02" text="The Band Transport subsystem shall continuously monitor conveyor speed using sensor data and detect deviations from the expected operating speed to support reliable transport operation." base_Class="_QRnScNIaEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_HGHY8NIqEfGKVdaTCg46lw" base_NamedElement="_HF9A4NIqEfGKVdaTCg46lw" id="BT-REQ-03" text="The Band Transport subsystem shall detect transport faults, including abnormal conveyor operation and section failures, and initiate appropriate fault handling actions to maintain safe and reliable operation." base_Class="_HF9A4NIqEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_W_AkQNIqEfGKVdaTCg46lw" base_Behavior="_W-5PgNIqEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_aa4OMNIqEfGKVdaTCg46lw" base_Behavior="_aa1K4NIqEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_fbu48NIqEfGKVdaTCg46lw" base_Behavior="_fbrOkNIqEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_mFPjkNIqEfGKVdaTCg46lw" base_NamedElement="_mFL5MNIqEfGKVdaTCg46lw" id="BT-REQ-04" text="The Band Transport subsystem shall provide a conveyor controller capable of processing section control commands and issuing appropriate control signals to the conveyor drive." base_Class="_mFL5MNIqEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_rGxjwNIqEfGKVdaTCg46lw" base_Behavior="_rGugcNIqEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_6QqUANIqEfGKVdaTCg46lw" base_NamedElement="_6QiYMNIqEfGKVdaTCg46lw" id="BT-REQ-05" text="The Band Transport subsystem shall provide a conveyor drive capable of executing control commands received from the conveyor controller to start, stop, and regulate conveyor movement." base_Class="_6QiYMNIqEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_F1g3QNIrEfGKVdaTCg46lw" base_Behavior="_F1cl0NIrEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_JyjUkNIrEfGKVdaTCg46lw" base_NamedElement="_JyfqMNIrEfGKVdaTCg46lw" id="BT-REQ-06" text="The Band Transport subsystem shall provide a speed sensor capable of measuring conveyor speed and transmitting speed data to the speed monitoring function for continuous supervision of conveyor operation." base_Class="_JyfqMNIrEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_SLhKoNIrEfGKVdaTCg46lw" base_Behavior="_SLdgQNIrEfGKVdaTCg46lw"/>
  <Requirements:Requirement xmi:id="_X2dUMNIrEfGKVdaTCg46lw" base_NamedElement="_X2ZCwNIrEfGKVdaTCg46lw" id="BT-REQ-07" text="The Band Transport subsystem shall provide a section status sensor capable of detecting the operational status of individual conveyor sections and transmitting status information to support section control and fault detection." base_Class="_X2ZCwNIrEfGKVdaTCg46lw"/>
  <Requirements:TestCase xmi:id="_fZUosNIrEfGKVdaTCg46lw" base_Behavior="_fZQ-UNIrEfGKVdaTCg46lw"/>
